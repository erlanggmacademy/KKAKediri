<!-- Client-side SheetJS Script for Real-time Excel Parsing -->
<script is:inline src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
  import { SCHOOL_DATABASE } from '../data/schools';
  import { processRegistration } from '../lib/registrationService';
  import { getActiveWave } from '../lib/pricing';
  import { supabase } from '../lib/supabase';

  function applyKolektifClose(regCfg: any) {
    if (regCfg && regCfg.kolektif && regCfg.kolektif.enabled === false) {
      const formCard = document.getElementById('kolektifFormCard');
      const closedNotice = document.getElementById('kolektifClosedNotice');
      const closedTitle = document.getElementById('kolektifClosedTitle');
      const closedMsg = document.getElementById('kolektifClosedMessage');
      const closedBadge = document.getElementById('kolektifClosedBadge');

      if (formCard) formCard.classList.add('d-none');
      if (closedNotice) closedNotice.classList.remove('d-none');
      if (closedTitle && regCfg.kolektif.closedTitle) closedTitle.textContent = regCfg.kolektif.closedTitle;
      if (closedMsg && regCfg.kolektif.closedMsg) closedMsg.textContent = regCfg.kolektif.closedMsg;
      if (closedBadge) {
        closedBadge.textContent = regCfg.kolektif.condition === 'kuota_penuh' ? 'KUOTA PENUH' : 'PENDAFTARAN DITUTUP';
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    let parsedStudents: any[] = [];
    const prices = getActiveWave().prices;

    const kolektifCard = document.getElementById('kolektifFormCard');
    const activeDistrictName = kolektifCard?.dataset.districtName || 'Kabupaten Kediri';
    const activeDistrictSlug = kolektifCard?.dataset.districtSlug || 'kabupaten-kediri';

    let schoolMeta = {
      namaSekolah: '',
      picName: '',
      picJabatan: 'Guru Pembina',
      waPic: '',
      wilayah: activeDistrictName,
      kecamatan: '',
      jenjang: 'SD / MI'
    };

    // Form & UI Elements
    const formEl = document.getElementById('formKkaKolektif') as HTMLFormElement;
    const excelDropzone = document.getElementById('excelDropzone');
    const btnPilihBerkas = document.getElementById('btnPilihBerkas');
    const excelFileInput = document.getElementById('excelFileInput') as HTMLInputElement;
    const dropzoneLabel = document.getElementById('dropzoneLabel');
    const dropzoneSubLabel = document.getElementById('dropzoneSubLabel');

    // Section 1: Template Selection Elements
    const templateJenjangSelect = document.getElementById('templateJenjangSelect') as HTMLSelectElement | null;
    const templateKecamatanSelect = document.getElementById('templateKecamatanSelect') as HTMLSelectElement | null;
    const templateDownloadBox = document.getElementById('templateDownloadBox');
    const templateBadgePreview = document.getElementById('templateBadgePreview');
    const templateTitlePreview = document.getElementById('templateTitlePreview');
    const btnDownloadCustomTemplate = document.getElementById('btnDownloadCustomTemplate');

    // Section 2: PIC & School Elements (School Dropdown with Manual Option)
    const inputNamaSekolah = document.getElementById('inputNamaSekolahKolektif') as HTMLSelectElement | null;
    const manualSchoolBoxKolektif = document.getElementById('manualSchoolBoxKolektif');
    const manualSchoolNameKolektif = document.getElementById('manualSchoolNameKolektif') as HTMLInputElement | null;
    const inputPicName = document.getElementById('inputPicName') as HTMLInputElement | null;
    const inputPicWa = document.getElementById('inputPicWa') as HTMLInputElement | null;
    const inputPicJabatan = document.getElementById('inputPicJabatan') as HTMLSelectElement | null;

    // Parsed Result Card Elements
    const parsedResultCard = document.getElementById('parsedResultCard');
    const btnChangeExcel = document.getElementById('btnChangeExcel');
    const displayNamaSekolah = document.getElementById('displayNamaSekolah');
    const displayWaPic = document.getElementById('displayWaPic');
    const displayWilayah = document.getElementById('displayWilayah');
    const displayKecamatan = document.getElementById('displayKecamatan');
    const displayJenjang = document.getElementById('displayJenjang');
    const displayCountSiswa = document.getElementById('displayCountSiswa');
    const displayTableBody = document.getElementById('displayTableBody');

    // Section 3: Payment & Summary Elements
    const rincianBiayaBox = document.getElementById('rincianBiayaBox');
    const rincianJumlahPeserta = document.getElementById('rincianJumlahPeserta');
    const rincianBiayaPerSiswa = document.getElementById('rincianBiayaPerSiswa');
    const rincianTotalBayar = document.getElementById('rincianTotalBayar');

    const kolektifSuccessCard = document.getElementById('kolektifSuccessCard');
    const btnResetKolektif = document.getElementById('btnResetKolektif');

    // Check if Kolektif registration is closed by Admin
    try {
      const storedReg = localStorage.getItem('kka_registration_status_control');
      if (storedReg) applyKolektifClose(JSON.parse(storedReg));
    } catch (e) {}

    // Async check to Cloud Supabase
    (async () => {
      try {
        const { data, error } = await supabase
          .from('app_settings')
          .select('value')
          .eq('key', 'registration_control')
          .single();

        if (!error && data && data.value) {
          applyKolektifClose(data.value);
          localStorage.setItem('kka_registration_status_control', JSON.stringify(data.value));
        }
      } catch (err) {}
    })();

    function formatRp(val: number) {
      return 'Rp ' + Number(val).toLocaleString('id-ID');
    }

    // Function to populate School Dropdown based on Wilayah, Jenjang, & Kecamatan
    function updateSchoolDropdown(prefillSchool = '') {
      if (!inputNamaSekolah) return;
      const currentSelection = prefillSchool || (inputNamaSekolah.value !== '__manual__' ? inputNamaSekolah.value : (manualSchoolNameKolektif?.value || ''));
      const jenjangVal = templateJenjangSelect ? templateJenjangSelect.value : '';
      const kecVal = templateKecamatanSelect ? templateKecamatanSelect.value : '';

      let jCat: 'sd' | 'smp' | 'sma' | '' = '';
      if (jenjangVal === 'SD-MI') jCat = 'sd';
      else if (jenjangVal === 'SMP-MTs') jCat = 'smp';
      else if (jenjangVal === 'SMA-MA-SMK') jCat = 'sma';

      const regData = (SCHOOL_DATABASE as any)[activeDistrictSlug];
      let schoolList: string[] = [];

      if (regData && regData.districts) {
        if (kecVal && regData.districts[kecVal]) {
          const dObj = regData.districts[kecVal];
          if (jCat && dObj[jCat]) {
            schoolList = [...dObj[jCat]];
          } else {
            schoolList = [...(dObj.sd || []), ...(dObj.smp || []), ...(dObj.sma || [])];
          }
        } else {
          // If no specific kecamatan selected yet, collect all schools for this jenjang in region
          Object.keys(regData.districts).forEach(k => {
            const dObj = regData.districts[k];
            if (jCat && dObj[jCat]) {
              schoolList.push(...dObj[jCat]);
            } else {
              schoolList.push(...(dObj.sd || []), ...(dObj.smp || []), ...(dObj.sma || []));
            }
          });
        }
      }

      schoolList = Array.from(new Set(schoolList)).sort((a, b) => a.localeCompare(b, 'id'));

      inputNamaSekolah.innerHTML = '<option value="">-- Pilih Asal Sekolah / Madrasah --</option>';

      // If prefill or custom school is not in list, add it
      if (currentSelection && currentSelection !== '__manual__' && !schoolList.includes(currentSelection)) {
        const customOpt = document.createElement('option');
        customOpt.value = currentSelection;
        customOpt.textContent = currentSelection;
        customOpt.selected = true;
        inputNamaSekolah.appendChild(customOpt);
      }

      schoolList.forEach(sch => {
        const opt = document.createElement('option');
        opt.value = sch;
        opt.textContent = sch;
        if (currentSelection === sch) opt.selected = true;
        inputNamaSekolah.appendChild(opt);
      });

      // Add manual entry option
      const manualOpt = document.createElement('option');
      manualOpt.value = '__manual__';
      manualOpt.textContent = '+ Sekolah Lainnya (Ketik Manual)...';
      if (currentSelection === '__manual__') manualOpt.selected = true;
      inputNamaSekolah.appendChild(manualOpt);

      // Handle visibility of manual input
      if (inputNamaSekolah.value === '__manual__') {
        if (manualSchoolBoxKolektif) manualSchoolBoxKolektif.classList.remove('d-none');
        if (manualSchoolNameKolektif) manualSchoolNameKolektif.required = true;
      } else {
        if (manualSchoolBoxKolektif) manualSchoolBoxKolektif.classList.add('d-none');
        if (manualSchoolNameKolektif) manualSchoolNameKolektif.required = false;
      }
    }

    // Interactive Template Downloader Controller
    function updateTemplateDownloadBox() {
      const jenjangVal = templateJenjangSelect ? templateJenjangSelect.value : '';
      const kecVal = templateKecamatanSelect ? templateKecamatanSelect.value : '';

      if (jenjangVal && kecVal) {
        if (templateBadgePreview) {
          templateBadgePreview.textContent = `${activeDistrictName} • Kec. ${kecVal}`;
        }
        if (templateTitlePreview) {
          templateTitlePreview.textContent = `KKA Kolektif ${jenjangVal} Kecamatan ${kecVal}.xlsx`;
        }
        if (templateDownloadBox) {
          templateDownloadBox.style.display = 'block';
        }
      } else {
        if (templateDownloadBox) {
          templateDownloadBox.style.display = 'none';
        }
      }

      // Automatically sync school dropdown options to matched Jenjang & Kecamatan
      updateSchoolDropdown();
    }

    if (templateJenjangSelect) templateJenjangSelect.addEventListener('change', updateTemplateDownloadBox);
    if (templateKecamatanSelect) templateKecamatanSelect.addEventListener('change', updateTemplateDownloadBox);

    // Initial population of school dropdown
    updateSchoolDropdown();

    // Generate and Download Excel Template matching the exact official structure
    if (btnDownloadCustomTemplate) {
      btnDownloadCustomTemplate.addEventListener('click', async () => {
        const jenjangVal = templateJenjangSelect ? templateJenjangSelect.value : '';
        const kecVal = templateKecamatanSelect ? templateKecamatanSelect.value : '';
        if (!jenjangVal || !kecVal) {
          alert('Silakan pilih Jenjang dan Kecamatan terlebih dahulu.');
          return;
        }

        const filename = `KKA Kolektif ${jenjangVal} Kecamatan ${kecVal}.xlsx`;
        const jenjangSlug = jenjangVal === 'SMP-MTs' ? 'SMP-MTS' : jenjangVal;

        // Build list of candidate file names (supporting SMP-MTS / SMP-MTs and Kota Kediri alias)
        const candidateFiles = [
          `KKA Kolektif ${jenjangVal} Kecamatan ${kecVal}.xlsx`,
          `KKA Kolektif ${jenjangSlug} Kecamatan ${kecVal}.xlsx`,
          kecVal === 'Kediri' ? `KKA Kolektif ${jenjangVal} Kecamatan Kota Kediri.xlsx` : null,
          kecVal === 'Kediri' ? `KKA Kolektif ${jenjangSlug} Kecamatan Kota Kediri.xlsx` : null
        ].filter(Boolean) as string[];

        // Candidate subfolder names
        const candidateFolders = [
          `Jenjang ${jenjangVal} ${activeDistrictName}`,
          `Jenjang ${jenjangSlug} ${activeDistrictName}`
        ];

        try {
          // Check static physical files in public/templates/kolektif/
          for (const fol of candidateFolders) {
            for (const fil of candidateFiles) {
              const structuredPath = `/templates/kolektif/Kolektif ${encodeURIComponent(activeDistrictName)}/${encodeURIComponent(fol)}/${encodeURIComponent(fil)}`;
              let res = await fetch(structuredPath, { method: 'HEAD' });
              if (res.ok) {
                const a = document.createElement('a');
                a.href = structuredPath;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                return;
              }
            }
          }

          // Also check flat path
          for (const fil of candidateFiles) {
            const flatPath = `/templates/kolektif/${encodeURIComponent(fil)}`;
            let res = await fetch(flatPath, { method: 'HEAD' });
            if (res.ok) {
              const a = document.createElement('a');
              a.href = flatPath;
              a.download = filename;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
              return;
            }
          }
        } catch (fetchErr) {
          console.warn('Checking static template file:', fetchErr);
        }

        // 3. Fallback: Dynamically generate official Excel file via SheetJS
        const XLSXLib = (window as any).XLSX;
        if (!XLSXLib) {
          alert('Library Excel sedang dimuat. Silakan tunggu 1-2 detik lalu coba lagi.');
          return;
        }

        // Build Array of Arrays (AOA) according to official KKA template format
        const aoaData = [
          [`Daftar Peserta Kolektif ${activeDistrictName}`],
          [`Jenjang : ${jenjangVal}`],
          [`Kecamatan : ${kecVal}`],
          [`Nama Sekolah : `],
          [],
          [
            'Nomer',
            'Nama Lengkap Peserta',
            'NISN',
            'Nomer Whatsapp Aktif',
            'Gender Peserta',
            'Kelas',
            'Nama Sekolah',
            'Jenjang Peserta',
            'Wilayah Sekolah',
            'Kecamatan Sekolah'
          ]
        ];

        // Append 20 rows of pre-filled sample templates
        for (let i = 1; i <= 20; i++) {
          aoaData.push([
            i,
            '',
            '',
            '',
            '',
            '',
            '',
            jenjangVal,
            activeDistrictName,
            kecVal
          ]);
        }

        const ws = XLSXLib.utils.aoa_to_sheet(aoaData);
        ws['!cols'] = [
          { wch: 8 },  // Nomer
          { wch: 32 }, // Nama Lengkap Peserta
          { wch: 18 }, // NISN
          { wch: 22 }, // Nomer Whatsapp Aktif
          { wch: 16 }, // Gender Peserta
          { wch: 12 }, // Kelas
          { wch: 32 }, // Nama Sekolah
          { wch: 18 }, // Jenjang Peserta
          { wch: 24 }, // Wilayah Sekolah
          { wch: 22 }  // Kecamatan Sekolah
        ];

        const wb = XLSXLib.utils.book_new();
        XLSXLib.utils.book_append_sheet(wb, ws, 'Daftar Pendaftar');
        XLSXLib.writeFile(wb, filename);
      });
    }

    // Live update parsed display when user interacts with Section 2
    if (inputNamaSekolah) {
      inputNamaSekolah.addEventListener('change', () => {
        if (inputNamaSekolah.value === '__manual__') {
          if (manualSchoolBoxKolektif) manualSchoolBoxKolektif.classList.remove('d-none');
          if (manualSchoolNameKolektif) {
            manualSchoolNameKolektif.required = true;
            manualSchoolNameKolektif.focus();
            schoolMeta.namaSekolah = manualSchoolNameKolektif.value.trim();
          }
        } else {
          if (manualSchoolBoxKolektif) manualSchoolBoxKolektif.classList.add('d-none');
          if (manualSchoolNameKolektif) {
            manualSchoolNameKolektif.required = false;
          }
          schoolMeta.namaSekolah = inputNamaSekolah.value;
        }
        if (displayNamaSekolah) displayNamaSekolah.textContent = schoolMeta.namaSekolah || '-';
      });
    }

    if (manualSchoolNameKolektif) {
      manualSchoolNameKolektif.addEventListener('input', () => {
        schoolMeta.namaSekolah = manualSchoolNameKolektif.value.trim();
        if (displayNamaSekolah) displayNamaSekolah.textContent = schoolMeta.namaSekolah || '-';
      });
    }

    if (inputPicWa) {
      inputPicWa.addEventListener('input', () => {
        schoolMeta.waPic = inputPicWa.value.trim();
        if (displayWaPic) displayWaPic.textContent = schoolMeta.waPic || '-';
      });
    }

    // Trigger File Picker
    if (btnPilihBerkas && excelFileInput) {
      btnPilihBerkas.addEventListener('click', (e) => {
        e.stopPropagation();
        excelFileInput.click();
      });
    }

    if (excelDropzone && excelFileInput) {
      excelDropzone.addEventListener('click', () => {
        excelFileInput.click();
      });
    }

    // Drag and Drop Effects
    if (excelDropzone) {
      ['dragenter', 'dragover'].forEach(eventName => {
        excelDropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          excelDropzone.classList.add('border-primary', 'bg-light');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        excelDropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          excelDropzone.classList.remove('border-primary', 'bg-light');
        }, false);
      });

      excelDropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files.length > 0) {
          handleFileSelection(dt.files[0]);
        }
      });
    }

    if (excelFileInput) {
      excelFileInput.addEventListener('change', (e: any) => {
        if (e.target.files && e.target.files.length > 0) {
          handleFileSelection(e.target.files[0]);
        }
      });
    }

    // Process Selected File
    function handleFileSelection(file: File) {
      if (!file) return;

      if (dropzoneLabel) dropzoneLabel.textContent = file.name;
      if (dropzoneSubLabel) dropzoneSubLabel.textContent = `${(file.size / 1024).toFixed(1)} KB - Membaca berkas...`;

      const reader = new FileReader();
      reader.onload = function (evt) {
        try {
          const data = new Uint8Array(evt.target?.result as ArrayBuffer);
          const XLSXLib = (window as any).XLSX;
          const workbook = XLSXLib.read(data, { type: 'array' });

          // Find appropriate sheet
          let sheetName = workbook.SheetNames.find((s: string) => {
            const l = s.toLowerCase();
            return l.includes('daftar') || l.includes('peserta') || l.includes('pendaftar');
          }) || workbook.SheetNames[0];

          const worksheet = workbook.Sheets[sheetName];
          const jsonRows = XLSXLib.utils.sheet_to_json(worksheet, { header: 1 });
          processExcelRows(jsonRows, file.name);
        } catch (err) {
          console.error(err);
          alert('Gagal membaca file Excel. Pastikan file valid (.xlsx, .xls, atau .csv).');
          resetToState1();
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function processExcelRows(rows: any[][], fileName: string) {
      if (!rows || rows.length < 2) {
        alert('File Excel kosong atau tidak memiliki baris data peserta.');
        resetToState1();
        return;
      }

      parsedStudents = [];
      let detectedSchool = '';
      let detectedKecamatan = '';
      let detectedWa = '';
      let detectedWilayah = '';
      let detectedJenjang = '';

      // 1. Scan metadata from top 6 rows (Title, Jenjang, Kecamatan, Nama Sekolah)
      for (let r = 0; r < Math.min(6, rows.length); r++) {
        const fullRowStr = (rows[r] || []).map(c => String(c || '').trim()).join(' ');

        // Check Wilayah from "Daftar Peserta Kolektif [Wilayah]"
        const mWilayah = fullRowStr.match(/daftar peserta kolektif\s+([A-Za-z\s]+)/i);
        if (mWilayah && mWilayah[1] && !detectedWilayah) {
          detectedWilayah = mWilayah[1].trim();
        }

        // Check Jenjang from "Jenjang : [Jenjang]"
        const mJenjang = fullRowStr.match(/jenjang\s*:\s*([A-Za-z0-9\-\/\s]+)/i);
        if (mJenjang && mJenjang[1] && !detectedJenjang) {
          detectedJenjang = mJenjang[1].trim();
        }

        // Check Kecamatan from "Kecamatan : [Kecamatan]"
        const mKec = fullRowStr.match(/kecamatan\s*:\s*([A-Za-z0-9\s]+)/i);
        if (mKec && mKec[1] && !detectedKecamatan) {
          detectedKecamatan = mKec[1].trim();
        }

        // Check Nama Sekolah from "Nama Sekolah : [Nama Sekolah]"
        const mSekolah = fullRowStr.match(/nama sekolah\s*:\s*(.+)/i);
        if (mSekolah && mSekolah[1] && mSekolah[1].trim() && !detectedSchool) {
          detectedSchool = mSekolah[1].trim();
        }
      }

      // 2. Find table header row (row containing student columns)
      let headerRowIndex = -1;
      for (let r = 0; r < Math.min(10, rows.length); r++) {
        const rowStr = (rows[r] || []).join(' ').toLowerCase();
        if ((rowStr.includes('nama') || rowStr.includes('peserta') || rowStr.includes('siswa')) && 
            (rowStr.includes('nisn') || rowStr.includes('gender') || rowStr.includes('kelas') || rowStr.includes('whatsapp') || rowStr.includes('kelamin'))) {
          headerRowIndex = r;
          break;
        }
      }
      if (headerRowIndex === -1) headerRowIndex = 0;

      const headerRow = (rows[headerRowIndex] || []).map(h => String(h || '').trim().toLowerCase());
      const colNama = headerRow.findIndex(h => h.includes('nama siswa') || h.includes('nama lengkap') || h === 'nama' || (h.includes('nama') && !h.includes('sekolah')));
      const colNisn = headerRow.findIndex(h => h.includes('nisn'));
      const colJenjang = headerRow.findIndex(h => h.includes('jenjang'));
      const colGender = headerRow.findIndex(h => h.includes('gender') || h.includes('kelamin') || h === 'jk');
      const colKelas = headerRow.findIndex(h => h.includes('kelas'));
      const colSekolah = headerRow.findIndex(h => h.includes('nama sekolah') || h.includes('sekolah') || h.includes('lembaga'));
      const colKecamatan = headerRow.findIndex(h => h.includes('kecamatan'));
      const colWa = headerRow.findIndex(h => h.includes('whatsapp') || h.includes('no wa') || h.includes('pic') || h.includes('telepon'));
      const colWilayah = headerRow.findIndex(h => h.includes('wilayah') || h.includes('kabupaten') || h.includes('kota'));

      const idxNama = colNama >= 0 ? colNama : 1;
      const idxNisn = colNisn >= 0 ? colNisn : 2;
      const idxJenjang = colJenjang >= 0 ? colJenjang : -1;
      const idxGender = colGender >= 0 ? colGender : -1;
      const idxKelas = colKelas >= 0 ? colKelas : -1;
      const idxSekolah = colSekolah >= 0 ? colSekolah : -1;
      const idxKecamatan = colKecamatan >= 0 ? colKecamatan : -1;
      const idxWa = colWa >= 0 ? colWa : -1;
      const idxWilayah = colWilayah >= 0 ? colWilayah : -1;

      // 3. Extract participants
      for (let i = headerRowIndex + 1; i < rows.length; i++) {
        const r = rows[i];
        if (!r) continue;

        const nama = String(r[idxNama] || '').trim();
        if (!nama || nama.toLowerCase().includes('contoh') || nama.toLowerCase().includes('keterangan') || nama === '-') continue;

        const nisn = idxNisn >= 0 ? String(r[idxNisn] || '').trim() : '-';
        const rawJenjang = idxJenjang >= 0 ? String(r[idxJenjang] || '').trim() : '';
        const rawGender = idxGender >= 0 ? String(r[idxGender] || '').trim() : '';
        const kelas = idxKelas >= 0 ? String(r[idxKelas] || '').trim() : '';

        // Extract metadata if present in columns
        if (idxSekolah >= 0 && r[idxSekolah] && !detectedSchool) {
          const sVal = String(r[idxSekolah]).trim();
          if (sVal && !sVal.includes('Nama Sekolah')) detectedSchool = sVal;
        }
        if (idxKecamatan >= 0 && r[idxKecamatan] && !detectedKecamatan) detectedKecamatan = String(r[idxKecamatan]).trim();
        if (idxWa >= 0 && r[idxWa] && !detectedWa) detectedWa = String(r[idxWa]).trim();
        if (idxWilayah >= 0 && r[idxWilayah] && !detectedWilayah) detectedWilayah = String(r[idxWilayah]).trim();
        if (rawJenjang && !detectedJenjang) detectedJenjang = rawJenjang;

        // Clean Gender
        let genderClean = 'Perempuan';
        const gLow = rawGender.toLowerCase();
        if (gLow.startsWith('l') || gLow.includes('pria') || gLow.includes('laki')) {
          genderClean = 'Laki-laki';
        }

        parsedStudents.push({
          no: parsedStudents.length + 1,
          nama,
          nisn: nisn || '-',
          gender: genderClean,
          kelas: kelas || 'Kelas V',
          rawJenjang: rawJenjang || detectedJenjang || 'SD'
        });
      }

      if (parsedStudents.length === 0) {
        alert('Tidak ditemukan data baris siswa yang valid di dalam file Excel.');
        resetToState1();
        return;
      }

      // Auto-fill input fields in Section 2 from Excel if detected
      if (detectedSchool) {
        updateSchoolDropdown(detectedSchool);
      }
      if (inputPicWa && !inputPicWa.value.trim() && detectedWa) {
        inputPicWa.value = detectedWa;
      }

      const selSekolah = inputNamaSekolah ? inputNamaSekolah.value : '';
      const actualSekolahVal = selSekolah === '__manual__'
        ? (manualSchoolNameKolektif ? manualSchoolNameKolektif.value.trim() : '')
        : selSekolah.trim();

      // Fill metadata fallbacks
      schoolMeta.namaSekolah = actualSekolahVal || detectedSchool || '';
      schoolMeta.waPic = (inputPicWa && inputPicWa.value.trim()) || detectedWa || '';
      schoolMeta.wilayah = detectedWilayah || activeDistrictName;
      schoolMeta.kecamatan = detectedKecamatan || (templateKecamatanSelect ? templateKecamatanSelect.value : '');

      // Detect Jenjang category for price calculation
      let jenjangCategory = 'sd';
      const jCheck = (detectedJenjang + ' ' + (parsedStudents[0] ? parsedStudents[0].rawJenjang : '') + ' ' + (templateJenjangSelect ? templateJenjangSelect.value : '')).toLowerCase();
      if (jCheck.includes('smp') || jCheck.includes('mts')) {
        jenjangCategory = 'smp';
        schoolMeta.jenjang = 'SMP / MTs';
      } else if (jCheck.includes('sma') || jCheck.includes('smk') || jCheck.includes('ma')) {
        jenjangCategory = 'sma';
        schoolMeta.jenjang = 'SMA / MA / SMK';
      } else {
        jenjangCategory = 'sd';
        schoolMeta.jenjang = 'SD / MI';
      }

      // Populate Metadata Card
      if (displayNamaSekolah) displayNamaSekolah.textContent = schoolMeta.namaSekolah || '(Isi di Bagian 2)';
      if (displayWaPic) displayWaPic.textContent = schoolMeta.waPic || '(Isi di Bagian 2)';
      if (displayWilayah) displayWilayah.textContent = schoolMeta.wilayah;
      if (displayKecamatan) displayKecamatan.textContent = schoolMeta.kecamatan || '-';
      if (displayJenjang) displayJenjang.textContent = schoolMeta.jenjang;
      if (displayCountSiswa) displayCountSiswa.textContent = String(parsedStudents.length);

      // Populate Table Body
      if (displayTableBody) {
        displayTableBody.innerHTML = '';
        parsedStudents.forEach(s => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="ps-3 text-center text-muted fw-semibold">${s.no}</td>
            <td class="fw-bold text-dark">${s.nama}</td>
            <td class="font-monospace">${s.nisn}</td>
            <td>${s.gender}</td>
            <td>${s.kelas}</td>
          `;
          displayTableBody.appendChild(tr);
        });
      }

      // Update Rincian Biaya
      const rate = prices[jenjangCategory] || 25000;
      const totalBayar = rate * parsedStudents.length;

      if (rincianJumlahPeserta) rincianJumlahPeserta.textContent = `${parsedStudents.length} Siswa`;
      if (rincianBiayaPerSiswa) rincianBiayaPerSiswa.textContent = formatRp(rate);
      if (rincianTotalBayar) rincianTotalBayar.textContent = formatRp(totalBayar);

      // TRANSITION TO STATE 2: Show parsed result card & rincian biaya
      if (dropzoneLabel) dropzoneLabel.textContent = fileName;
      if (dropzoneSubLabel) dropzoneSubLabel.textContent = `Berhasil membaca ${parsedStudents.length} peserta`;
      if (parsedResultCard) parsedResultCard.classList.remove('d-none');
      if (rincianBiayaBox) rincianBiayaBox.classList.remove('d-none');
    }

    function resetToState1() {
      parsedStudents = [];
      if (excelFileInput) excelFileInput.value = '';
      if (dropzoneLabel) dropzoneLabel.textContent = 'Pilih atau Tarik File Excel ke Sini';
      if (dropzoneSubLabel) dropzoneSubLabel.textContent = 'Mendukung format .xlsx, .xls, .csv';
      if (parsedResultCard) parsedResultCard.classList.add('d-none');
      if (rincianBiayaBox) rincianBiayaBox.classList.add('d-none');
    }

    if (btnChangeExcel && excelFileInput) {
      btnChangeExcel.addEventListener('click', () => {
        excelFileInput.value = '';
        excelFileInput.click();
      });
    }

    // Form Submit Handler
    if (formEl) {
      formEl.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (parsedStudents.length === 0) {
          alert('Silakan unggah dan pilih berkas Excel data siswa terlebih dahulu.');
          if (excelDropzone) excelDropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        // Validate Section 2: Data PIC & Sekolah
        const selSekolah = inputNamaSekolah ? inputNamaSekolah.value : '';
        const namaSekolahVal = selSekolah === '__manual__' 
          ? (manualSchoolNameKolektif ? manualSchoolNameKolektif.value.trim() : '') 
          : selSekolah.trim();
        const picNameVal = inputPicName ? inputPicName.value.trim() : '';
        const picWaVal = inputPicWa ? inputPicWa.value.trim() : '';
        const picJabatanVal = inputPicJabatan ? inputPicJabatan.value : 'Guru Pembina';

        if (!namaSekolahVal || !picNameVal || !picWaVal) {
          formEl.classList.add('was-validated');
          if (!namaSekolahVal) {
            if (selSekolah === '__manual__' && manualSchoolNameKolektif) {
              manualSchoolNameKolektif.focus();
            } else if (inputNamaSekolah) {
              inputNamaSekolah.focus();
            }
          } else if (!picNameVal && inputPicName) {
            inputPicName.focus();
          } else if (!picWaVal && inputPicWa) {
            inputPicWa.focus();
          }
          return;
        }

        const proofInput = document.getElementById('transferProofKolektif') as HTMLInputElement;
        if (!proofInput || !proofInput.files || proofInput.files.length === 0) {
          formEl.classList.add('was-validated');
          if (proofInput) proofInput.focus();
          return;
        }

        schoolMeta.namaSekolah = namaSekolahVal;
        schoolMeta.picName = picNameVal;
        schoolMeta.picJabatan = picJabatanVal;
        schoolMeta.waPic = picWaVal;

        // Show Loading Spinner on Submit Button
        const btnSubmit = document.getElementById('btnSubmitKolektif') as HTMLButtonElement;
        const originalBtnText = btnSubmit.innerHTML;
        btnSubmit.disabled = true;
        btnSubmit.innerHTML = `
          <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
          Menyimpan ke Database & Spreadsheet...
        `;

        try {
          const randomCode = Math.floor(1000 + Math.random() * 9000);
          const distCode = activeDistrictSlug.includes('kota') ? 'KDR' : (activeDistrictSlug.includes('nganjuk') ? 'NGJ' : 'KAB');
          const regCode = `KKA26-K-${distCode}-${randomCode}`;

          // Send to Supabase & Google Apps Script
          const totalBayarNumber = parseInt(rincianTotalBayar?.textContent?.replace(/[^0-9]/g, '') || '0', 10) || 0;

          await processRegistration({
            kode: regCode,
            tipe: 'kolektif',
            wilayah: schoolMeta.wilayah,
            kecamatan: schoolMeta.kecamatan,
            sekolah: schoolMeta.namaSekolah,
            jenjang: schoolMeta.jenjang,
            namaKontak: `${schoolMeta.picName} (${schoolMeta.picJabatan})`,
            hpKontak: schoolMeta.waPic,
            totalBiaya: totalBayarNumber,
            students: parsedStudents.map(s => ({
              nama: s.nama,
              nisn: s.nisn,
              gender: s.gender,
              kelas: s.kelas
            })),
            proofFile: proofInput.files.length > 0 ? proofInput.files[0] : null
          });

          // Populate Success Card
          const resultKodeKolektif = document.getElementById('resultKodeKolektif');
          if (resultKodeKolektif) resultKodeKolektif.textContent = regCode;
          const summarySekolah = document.getElementById('summarySekolah');
          if (summarySekolah) summarySekolah.textContent = schoolMeta.namaSekolah;
          const summaryPicName = document.getElementById('summaryPicName');
          if (summaryPicName) summaryPicName.textContent = `${schoolMeta.picName} (${schoolMeta.picJabatan})`;
          const summaryWilayah = document.getElementById('summaryWilayah');
          if (summaryWilayah) summaryWilayah.textContent = `${schoolMeta.wilayah}${schoolMeta.kecamatan ? ` (Kec. ${schoolMeta.kecamatan})` : ''}`;
          const summaryJenjang = document.getElementById('summaryJenjang');
          if (summaryJenjang) summaryJenjang.textContent = schoolMeta.jenjang;
          const summaryWaPic = document.getElementById('summaryWaPic');
          if (summaryWaPic) summaryWaPic.textContent = schoolMeta.waPic;
          const summaryCountSiswa = document.getElementById('summaryCountSiswa');
          if (summaryCountSiswa) summaryCountSiswa.textContent = `${parsedStudents.length} Siswa Terdaftar`;
          const summaryTotalBayar = document.getElementById('summaryTotalBayar');
          if (summaryTotalBayar && rincianTotalBayar) summaryTotalBayar.textContent = rincianTotalBayar.textContent;

          // Prepare WhatsApp message
          let msg = `*KONFIRMASI PENDAFTARAN KOLEKTIF KKA 2026*\n`;
          msg += `Halo Panitia KKA Radar Kediri,\nSaya mengonfirmasi pendaftaran kolektif sekolah via berkas Excel:\n\n`;
          msg += `*Kode Pendaftaran*: ${regCode}\n`;
          msg += `*Nama Sekolah*: ${schoolMeta.namaSekolah}\n`;
          msg += `*Guru Pembina / PIC*: ${schoolMeta.picName} (${schoolMeta.picJabatan})\n`;
          msg += `*WhatsApp PIC*: ${schoolMeta.waPic}\n`;
          msg += `*Wilayah*: ${schoolMeta.wilayah}\n`;
          msg += `*Kecamatan*: ${schoolMeta.kecamatan || '-'}\n`;
          msg += `*Jenjang*: ${schoolMeta.jenjang}\n`;
          msg += `*Jumlah Peserta*: ${parsedStudents.length} Siswa\n`;
          msg += `*Total Pembayaran*: ${rincianTotalBayar ? rincianTotalBayar.textContent : '-'}\n\n`;
          msg += `*Daftar Siswa (Sampel)*:\n`;
          parsedStudents.slice(0, 5).forEach(s => {
            msg += `${s.no}. ${s.nama} | NISN: ${s.nisn} | ${s.kelas} (${s.gender})\n`;
          });
          if (parsedStudents.length > 5) {
            msg += `... dan ${parsedStudents.length - 5} siswa lainnya terlampir di file Excel.\n`;
          }
          msg += `\nBerkas Excel dan bukti transfer telah diunggah. Mohon verifikasi pendaftaran sekolah kami. Terima kasih.`;

          const btnWa = document.getElementById('btnWaKolektifDirect') as HTMLAnchorElement;
          if (btnWa) {
            btnWa.href = `https://wa.me/6281235508957?text=${encodeURIComponent(msg)}`;
          }
          const btnCheckStatus = document.getElementById('btnCheckStatusDirectKolektif') as HTMLAnchorElement;
          if (btnCheckStatus) {
            btnCheckStatus.href = `/daftar/status?kode=${encodeURIComponent(regCode)}`;
          }
          const btnCetakDoc = document.getElementById('btnCetakBuktiDirectKolektif') as HTMLAnchorElement;
          if (btnCetakDoc) {
            btnCetakDoc.href = `/daftar/cetak?kode=${encodeURIComponent(regCode)}`;
          }

          // Switch to Success State
          formEl.classList.add('d-none');
          if (kolektifSuccessCard) {
            kolektifSuccessCard.classList.remove('d-none');
            window.scrollTo({ top: kolektifSuccessCard.offsetTop - 80, behavior: 'smooth' });
          }
        } catch (submitErr) {
          console.error('Submit error:', submitErr);
          alert('Terjadi kendala saat mengirim pendaftaran. Silakan periksa koneksi internet Anda atau coba lagi.');
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = originalBtnText;
        }
      });
    }

    // Copy account number handler
    document.querySelectorAll('.btn-copy-account').forEach(btn => {
      btn.addEventListener('click', () => {
        const textToCopy = btn.getAttribute('data-copy');
        if (textToCopy) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            const span = btn.querySelector('span');
            if (span) {
              const origText = span.textContent;
              span.textContent = 'Tersalin!';
              btn.classList.remove('btn-primary');
              btn.classList.add('btn-success');
              setTimeout(() => {
                span.textContent = origText;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-primary');
              }, 2000);
            }
          }).catch(() => {});
        }
      });
    });

    if (btnResetKolektif) {
      btnResetKolektif.addEventListener('click', () => {
        formEl.reset();
        formEl.classList.remove('was-validated');
        resetToState1();
        if (templateJenjangSelect) templateJenjangSelect.value = '';
        if (templateKecamatanSelect) templateKecamatanSelect.value = '';
        if (templateDownloadBox) templateDownloadBox.style.display = 'none';
        if (manualSchoolBoxKolektif) manualSchoolBoxKolektif.classList.add('d-none');
        if (manualSchoolNameKolektif) {
          manualSchoolNameKolektif.value = '';
          manualSchoolNameKolektif.required = false;
        }
        if (inputNamaSekolah) inputNamaSekolah.value = '';
        updateSchoolDropdown();
        if (kolektifSuccessCard) kolektifSuccessCard.classList.add('d-none');
        formEl.classList.remove('d-none');
        window.scrollTo({ top: formEl.offsetTop - 80, behavior: 'smooth' });
      });
    }

  });
</script>

