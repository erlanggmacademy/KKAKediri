---
import { WAVES, DISTRICTS } from '../data/competition';
import { SCHOOL_DATABASE } from '../data/schools';
import { getActiveWave, formatRupiah } from '../lib/pricing';

interface Props {
  defaultDistrictSlug?: string;
  defaultDistrictName?: string;
}

const { 
  defaultDistrictSlug = 'kabupaten-kediri', 
  defaultDistrictName = 'Kabupaten Kediri' 
} = Astro.props;

const currentWave = getActiveWave();
const currentRegionSchools = SCHOOL_DATABASE[defaultDistrictSlug] || SCHOOL_DATABASE['kabupaten-kediri'];
const kecamatanList = currentRegionSchools ? Object.keys(currentRegionSchools.districts || {}).sort((a, b) => a.localeCompare(b, 'id')) : [];
---

<div class="form-kolektif-wrapper max-w-4xl mx-auto">
  
  <!-- Header Title Outside Card -->
  <div class="form-header-box mb-3 text-start">
    <h2 class="h3 fw-bold text-dark mb-1">Form Pendaftaran Kolektif</h2>
    <p class="text-secondary small mb-0">
      Silakan isi data sekolah dan daftar peserta di bawah ini
    </p>
  </div>

  <!-- Closed State Notice if Kolektif Disabled by Admin -->
  <div id="kolektifClosedNotice" class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white mb-4 d-none">
    <div class="mb-3">
      <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex p-3">
        <svg width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
      </div>
    </div>
    <span class="badge bg-danger rounded-pill px-3 py-1 fs-8 fw-bold mb-2 w-fit mx-auto" id="kolektifClosedBadge">PENDAFTARAN KOLEKTIF DITUTUP</span>
    <h2 class="h3 fw-bold text-dark mb-2" id="kolektifClosedTitle">Pendaftaran Kolektif Telah Ditutup</h2>
    <p class="text-secondary lead fs-6 max-w-xl mx-auto mb-4" id="kolektifClosedMessage">
      Pendaftaran rombongan kolektif sekolah KKA 2026 telah resmi ditutup. Untuk konfirmasi data rombongan atau koordinasi kuota khusus sekolah, silakan hubungi koordinator panitia.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="/cek-status" class="btn btn-primary px-4 py-2.5 rounded-pill fw-semibold shadow-sm">
        Cek Status Pendaftaran Sekolah
      </a>
      <a href="/daftar" class="btn btn-outline-secondary px-4 py-2.5 rounded-pill fw-semibold">
        Kembali ke Portal
      </a>
    </div>
  </div>

  <!-- Main Card with Crisp Royal Blue Border -->
  <div 
    class="card rounded-4 p-4 p-md-5 bg-white shadow-sm mb-4 form-main-card" 
    id="kolektifFormCard"
    data-district-name={defaultDistrictName}
    data-district-slug={defaultDistrictSlug}
  >
    
    <form id="formKkaKolektif" class="needs-validation" novalidate>

      <!-- 1. Unggah Berkas Pendaftaran (Excel) -->
      <div class="form-section mb-4 pb-2">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="section-indicator-bar bg-primary rounded-pill"></span>
          <h3 class="h5 fw-bold text-dark mb-0">1. Unggah Berkas Pendaftaran (Excel)</h3>
        </div>
        
        <p class="text-secondary small mb-3">
          Pendaftaran kolektif kini sepenuhnya menggunakan Excel. Silakan unduh template Excel kami di bawah ini, isi data sekolah beserta daftar siswa, lalu unggah kembali berkas tersebut.
        </p>

        <!-- Box Unduh Template Excel Resmi Berdasarkan Jenjang & Kecamatan -->
        <div class="p-3.5 p-md-4 rounded-4 border bg-light mb-4">
          <div class="d-flex align-items-center gap-2 mb-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1d72f2" stroke-width="2.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <strong class="text-dark small">Unduh Template Excel Resmi:</strong>
          </div>
          <p class="text-secondary small mb-3">
            Pilih <strong>Jenjang</strong> dan <strong>Kecamatan</strong> sekolah Anda ({defaultDistrictName}) agar format template langsung sesuai wilayah Anda:
          </p>

          <div class="row g-3">
            <div class="col-md-5">
              <label for="templateJenjangSelect" class="form-label small fw-semibold text-dark mb-1">
                Pilih Jenjang <span class="text-danger">*</span>
              </label>
              <select id="templateJenjangSelect" class="form-select py-2.5 rounded-3">
                <option value="">-- Pilih Jenjang --</option>
                <option value="SD-MI">SD / MI Sederajat</option>
                <option value="SMP-MTs">SMP / MTs Sederajat</option>
                <option value="SMA-MA-SMK">SMA / MA / SMK Sederajat</option>
              </select>
            </div>

            <div class="col-md-7">
              <label for="templateKecamatanSelect" class="form-label small fw-semibold text-dark mb-1">
                Pilih Kecamatan ({defaultDistrictName}) <span class="text-danger">*</span>
              </label>
              <select id="templateKecamatanSelect" class="form-select py-2.5 rounded-3">
                <option value="">-- Pilih Kecamatan --</option>
                {kecamatanList.map(kec => (
                  <option value={kec}>Kecamatan {kec}</option>
                ))}
              </select>
            </div>

            <!-- Tombol Unduh Muncul Setelah Jenjang & Kecamatan Terpilih -->
            <div class="col-12 mt-3" id="templateDownloadBox" style="display: none;">
              <div class="p-3 bg-white rounded-3 border d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2.5">
                <div>
                  <span class="badge bg-primary text-white rounded-pill px-2.5 py-0.5 fs-9 fw-semibold mb-1" id="templateBadgePreview">
                    Template Siap
                  </span>
                  <div class="fw-bold text-dark fs-6" id="templateTitlePreview">
                    KKA Kolektif Kecamatan
                  </div>
                  <span class="text-muted small" style="font-size: 0.8rem;">
                    Format resmi Excel (.xlsx) dengan metadata wilayah & jenjang otomatis.
                  </span>
                </div>
                <button 
                  type="button" 
                  id="btnDownloadCustomTemplate" 
                  class="btn btn-primary btn-sm px-3.5 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-1.5 shadow-2xs hover-scale flex-shrink-0"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                  </svg>
                  <span>Unduh File Excel</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Dashed Drag & Drop Box -->
        <div 
          id="excelDropzone" 
          class="border border-dashed rounded-4 p-4 p-md-5 text-center bg-white mb-4 position-relative cursor-pointer hover-dropzone"
        >
          <!-- Excel File Icon (Blue sheet with 'X') -->
          <div class="excel-icon-box mx-auto mb-3 d-flex align-items-center justify-content-center">
            <svg width="46" height="46" viewBox="0 0 24 24" fill="none">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" fill="#1d72f2"/>
              <polyline points="14 2 14 8 20 8" fill="#1557bf"/>
              <line x1="9.5" y1="12" x2="14.5" y2="18" stroke="white" stroke-width="2" stroke-linecap="round"/>
              <line x1="14.5" y1="12" x2="9.5" y2="18" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>

          <div class="fw-bold text-dark fs-6 mb-1" id="dropzoneLabel">Pilih atau Tarik File Excel ke Sini</div>
          <div class="text-muted small mb-3" id="dropzoneSubLabel">Mendukung format .xlsx, .xls, .csv</div>

          <button 
            type="button" 
            id="btnPilihBerkas" 
            class="btn btn-sm btn-light border text-dark fw-semibold px-3 py-1.5 rounded-3 d-inline-flex align-items-center gap-1.5 shadow-2xs"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
            Pilih Berkas
          </button>

          <!-- Hidden Input File -->
          <input 
            type="file" 
            id="excelFileInput" 
            class="d-none" 
            accept=".xlsx, .xls, .csv" 
          />
        </div>

        <!-- STATE 2: Parsed Excel Result Card (Hidden by default in State 1) -->
        <div id="parsedResultCard" class="d-none border rounded-4 p-4 mb-3 bg-white shadow-2xs">
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-2 text-success fw-bold fs-6">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
              <span>Berkas Valid & Berhasil Dibaca!</span>
            </div>
            
            <button 
              type="button" 
              id="btnChangeExcel" 
              class="btn btn-link text-primary text-decoration-none p-0 small fw-semibold"
            >
              Ganti Berkas Excel
            </button>
          </div>

          <!-- School Metadata 2-Column Grid -->
          <div class="p-3 p-md-4 bg-light rounded-3 border mb-4">
            <div class="row g-2 small">
              <div class="col-md-6">
                <div class="d-flex">
                  <span class="text-muted" style="width: 145px;">Nama Sekolah</span>
                  <span class="me-2">:</span>
                  <strong class="text-dark" id="displayNamaSekolah">-</strong>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex">
                  <span class="text-muted" style="width: 145px;">WhatsApp PIC</span>
                  <span class="me-2">:</span>
                  <strong class="text-dark" id="displayWaPic">-</strong>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex">
                  <span class="text-muted" style="width: 145px;">Wilayah Sekolah</span>
                  <span class="me-2">:</span>
                  <strong class="text-dark" id="displayWilayah">-</strong>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex">
                  <span class="text-muted" style="width: 145px;">Kecamatan Sekolah</span>
                  <span class="me-2">:</span>
                  <strong class="text-dark" id="displayKecamatan">-</strong>
                </div>
              </div>
              <div class="col-md-6">
                <div class="d-flex">
                  <span class="text-muted" style="width: 145px;">Jenjang Pendidikan</span>
                  <span class="me-2">:</span>
                  <strong class="text-dark" id="displayJenjang">-</strong>
                </div>
              </div>
            </div>
          </div>

          <!-- Table of Students -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="fw-bold text-dark mb-0">
              Daftar Peserta (<span id="displayCountSiswa">0</span> Siswa)
            </h6>
          </div>
          
          <div class="table-responsive border rounded-3 bg-white" style="max-height: 320px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0 small text-nowrap">
              <thead class="table-light sticky-top">
                <tr>
                  <th style="width: 45px;" class="ps-3 text-center">#</th>
                  <th>Nama Siswa</th>
                  <th>NISN</th>
                  <th>Gender</th>
                  <th>Kelas</th>
                </tr>
              </thead>
              <tbody id="displayTableBody">
                <!-- Injected via JavaScript -->
              </tbody>
            </table>
          </div>

        </div>

      </div>

      <!-- 2. Data Sekolah & Koordinator PIC -->
      <div class="form-section mb-4 pb-2">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="section-indicator-bar bg-primary rounded-pill"></span>
          <h3 class="h5 fw-bold text-dark mb-0">2. Data Sekolah & Koordinator PIC</h3>
        </div>
        <p class="text-secondary small mb-3">
          Informasi narahubung koordinator / guru pembina untuk koordinasi dan verifikasi berkas ujian siswa.
        </p>

        <div class="row g-3">
          <div class="col-md-6">
            <label for="inputNamaSekolahKolektif" class="form-label small fw-semibold text-dark">
              Nama Lengkap Sekolah / Madrasah <span class="text-danger">*</span>
            </label>
            <select 
              id="inputNamaSekolahKolektif" 
              class="form-select py-2.5 rounded-3" 
              required 
            >
              <option value="">-- Pilih Sekolah / Madrasah --</option>
            </select>
            <div class="invalid-feedback">Nama sekolah wajib dipilih.</div>

            <!-- Input Manual jika sekolah belum terdaftar di list -->
            <div id="manualSchoolBoxKolektif" class="mt-2 d-none">
              <input 
                type="text" 
                id="manualSchoolNameKolektif" 
                class="form-control form-control-sm py-2 rounded-3" 
                placeholder="Ketik nama lengkap sekolah Anda..." 
              />
              <span class="fs-8 text-muted">Ketik nama lengkap sekolah jika tidak ada di daftar.</span>
            </div>
          </div>

          <div class="col-md-6">
            <label for="inputPicName" class="form-label small fw-semibold text-dark">
              Nama Lengkap Guru Pembina / PIC <span class="text-danger">*</span>
            </label>
            <input 
              type="text" 
              id="inputPicName" 
              class="form-control py-2.5 rounded-3" 
              placeholder="cth: Drs. Bambang Sutrisno, M.Pd." 
              required 
            />
            <div class="invalid-feedback">Nama koordinator PIC wajib diisi.</div>
          </div>

          <div class="col-md-6">
            <label for="inputPicWa" class="form-label small fw-semibold text-dark">
              Nomor WhatsApp Aktif PIC <span class="text-danger">*</span>
            </label>
            <input 
              type="tel" 
              id="inputPicWa" 
              class="form-control py-2.5 rounded-3" 
              placeholder="cth: 081234567890" 
              required 
            />
            <div class="form-text fs-8 text-muted">
              Nomor WhatsApp ini digunakan panitia untuk pengiriman kartu ujian dan informasi teknis perlombaan.
            </div>
            <div class="invalid-feedback">Nomor WhatsApp aktif wajib diisi dengan benar.</div>
          </div>

          <div class="col-md-6">
            <label for="inputPicJabatan" class="form-label small fw-semibold text-dark">
              Jabatan / Peran PIC di Sekolah
            </label>
            <select id="inputPicJabatan" class="form-select py-2.5 rounded-3">
              <option value="Guru Pembina">Guru Pembina / Pendamping Lomba</option>
              <option value="Koordinator Lomba">Koordinator Lomba Sekolah</option>
              <option value="Wakasek Kesiswaan / Kurikulum">Wakasek Kesiswaan / Kurikulum</option>
              <option value="Kepala Sekolah">Kepala Sekolah</option>
              <option value="Staf Tata Usaha">Staf Tata Usaha / Operator</option>
            </select>
          </div>
        </div>
      </div>

      <!-- 3. Pembayaran & Konfirmasi -->
      <div class="form-section mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <span class="section-indicator-bar bg-primary rounded-pill"></span>
          <h3 class="h5 fw-bold text-dark mb-0">3. Pembayaran & Konfirmasi</h3>
        </div>

        <!-- Rekening Pembayaran Resmi -->
        <div class="payment-accounts-wrapper mb-4">
          <div class="d-flex align-items-center gap-2 mb-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1d72f2" stroke-width="2.5" class="flex-shrink-0">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="16" x2="12" y2="12"/>
              <line x1="12" y1="8" x2="12.01" y2="8"/>
            </svg>
            <span class="small fw-bold text-dark">
              Rekening Resmi Pembayaran Panitia:
            </span>
          </div>

          <div class="bank-account-card p-3.5 p-md-4 rounded-4 border bg-white shadow-2xs">
            <!-- Header Kartu: Logo BRI & Nama Bank -->
            <div class="d-flex align-items-center mb-3 pb-2.5 border-bottom">
              <div class="d-flex align-items-center gap-3">
                <img 
                  src="/images/bri.webp" 
                  alt="Logo Bank BRI" 
                  width="36" 
                  height="36" 
                  style="object-fit: contain;"
                  loading="lazy"
                />
                <span class="fs-5 fw-bold text-dark mb-0">Bank BRI</span>
              </div>
            </div>

            <!-- Bagian Nomor Rekening Panjang & Tombol Salin -->
            <div class="p-3 bg-light rounded-3 border mb-2.5">
              <span class="text-muted small d-block mb-1" style="font-size: 0.78rem;">Nomor Rekening BRI:</span>
              <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2.5">
                <div class="account-number font-monospace fw-bold text-primary fs-3 text-nowrap" style="letter-spacing: 1px;">
                  0033-0100-3455-560
                </div>
                <div>
                  <button 
                    type="button" 
                    class="btn btn-primary btn-sm px-3.5 py-1.5 rounded-pill fw-semibold btn-copy-account d-inline-flex align-items-center gap-1.5 shadow-2xs hover-scale" 
                    data-copy="003301003455560" 
                    title="Salin nomor rekening BRI"
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span>Salin No. Rekening</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Footer: Pemilik Rekening -->
            <div class="d-flex align-items-center justify-content-between text-muted small px-1 flex-wrap gap-1" style="font-size: 0.82rem;">
              <span>Atas Nama (Penerima):</span>
              <strong class="text-dark fs-6">Heri Muda Setiawan</strong>
            </div>
          </div>
        </div>

        <!-- Bukti Transfer Upload -->
        <div class="mb-4">
          <label class="form-label small fw-semibold text-dark">
            Bukti Transfer (Format Gambar) <span class="text-danger">*</span>
          </label>
          <div class="upload-wrapper border rounded-3 p-3 bg-light">
            <input 
              type="file" 
              id="transferProofKolektif" 
              class="form-control" 
              accept="image/png, image/jpeg, image/jpg, image/webp, application/pdf" 
              required 
            />
            <div class="form-text fs-8 text-muted mt-1.5">
              Lampirkan struk transfer / bukti mutasi pembayaran panitia. Maks. 2MB.
            </div>
            <div class="invalid-feedback">Bukti transfer pembayaran wajib dilampirkan.</div>
          </div>
        </div>

        <!-- STATE 2: Rincian Biaya (Hidden by default in State 1) -->
        <div id="rincianBiayaBox" class="d-none border rounded-3 p-4 bg-white mb-4 shadow-2xs">
          <div class="d-flex align-items-center gap-1.5 fw-bold text-dark small mb-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
            <span>Rincian Biaya</span>
          </div>

          <div class="d-flex justify-content-between text-secondary small mb-1.5">
            <span>Jumlah Peserta:</span>
            <strong class="text-dark" id="rincianJumlahPeserta">-</strong>
          </div>

          <div class="d-flex justify-content-between text-secondary small mb-3">
            <span>Biaya per Siswa:</span>
            <strong class="text-dark" id="rincianBiayaPerSiswa">-</strong>
          </div>

          <div class="border-top border-dashed pt-2.5 d-flex justify-content-between align-items-center">
            <strong class="text-dark fs-6">Total Pembayaran:</strong>
            <strong class="text-primary fs-5" id="rincianTotalBayar">Rp 0</strong>
          </div>
        </div>

        <!-- Tombol Kirim Pendaftaran Kolektif -->
        <button 
          type="submit" 
          id="btnSubmitKolektif" 
          class="btn btn-primary btn-lg w-100 fw-bold py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 hover-scale"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
            <polyline points="12 13 12 7 9 10"/>
            <polyline points="12 7 15 10"/>
          </svg>
          Kirim Pendaftaran Kolektif
        </button>

      </div>

    </form>

    <!-- Success Confirmation Receipt Card (Hidden by default) -->
    <div id="kolektifSuccessCard" class="d-none">
      <div class="text-center py-4 border-bottom mb-4">
        <div class="success-icon-badge bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h3 class="fw-bold text-dark mb-1">Pendaftaran Kolektif Berhasil Dikirim!</h3>
        <p class="text-secondary small mb-3">
          Berkas Excel dan data rombongan sekolah Anda telah diterima oleh sistem KKA 2026.
        </p>
        <div class="p-3 bg-light rounded-3 border d-inline-block px-4">
          <span class="fs-8 text-muted text-uppercase fw-semibold d-block">Kode Registrasi Kolektif</span>
          <span id="resultKodeKolektif" class="h4 fw-black text-primary font-monospace mb-0">-</span>
        </div>
      </div>

      <!-- Detail Rangkuman -->
      <div class="receipt-summary bg-light p-4 rounded-3 border mb-4">
        <h5 class="fw-bold text-dark mb-3 fs-6">Rangkuman Pendaftaran Sekolah:</h5>
        <div class="row g-2 small">
          <div class="col-sm-4 text-muted">Nama Sekolah:</div>
          <div class="col-sm-8 fw-semibold text-dark" id="summarySekolah">-</div>

          <div class="col-sm-4 text-muted">Guru Pembina / PIC:</div>
