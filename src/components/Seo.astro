---
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  noindex?: boolean;
  schema?: Record<string, any>;
}

const {
  title = 'Kompetisi Kompetensi Akademik (KKA) 2026 - Jawa Pos Radar Kediri',
  description = 'Website resmi Kompetisi Kompetensi Akademik (KKA) Jawa Pos Radar Kediri 2026. Lomba akademik jenjang SD/MI, SMP/MTs, dan SMA/MA/SMK berstandar TKA bekerjasama dengan Neutron Yogyakarta.',
  canonical,
  ogImage = '/images/og-kka-2026.jpg',
  type = 'website',
  noindex = false,
  schema
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site || 'https://kkaradarkediri.com').href;
const fullOgImage = new URL(ogImage, Astro.site || 'https://kkaradarkediri.com').href;

// Default WebPage Schema for subpages without a custom schema
const defaultWebPageSchema = !schema && !noindex ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonicalURL,
  "inLanguage": "id-ID",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Kompetisi Kompetensi Akademik (KKA) 2026",
    "url": "https://kkaradarkediri.com"
  },
  "publisher": {
    "@type": "EducationalOrganization",
    "name": "Jawa Pos Radar Kediri",
    "url": "https://kkaradarkediri.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://kkaradarkediri.com/images/logo-kka.webp"
    }
  }
} : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- SEO & Geographical Meta Tags -->
<meta name="author" content="Jawa Pos Radar Kediri" />
<meta name="keywords" content="KKA 2026, Kompetisi Kompetensi Akademik, Radar Kediri, Lomba Akademik Kediri, Olimpiade SD Kediri, Lomba SMP Nganjuk, TKA SMA Blitar, Bimbel Neutron Yogyakarta, Simulasi TKA Karesidenan Kediri" />
<meta name="geo.region" content="ID-JI" />
<meta name="geo.placename" content="Kediri, Jawa Timur" />
<meta name="geo.position" content="-7.8166;112.0167" />
<meta name="ICBM" content="-7.8166, 112.0167" />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:secure_url" content={fullOgImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="675" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content="KKA Jawa Pos Radar Kediri" />
<link rel="image_src" href={fullOgImage} />
<meta name="theme-color" content="#0f2d59" />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />

<!-- JSON-LD Structured Data -->
{schema ? (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
) : (
  defaultWebPageSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(defaultWebPageSchema)} />
  )
)}
