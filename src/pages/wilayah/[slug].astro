---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { DISTRICTS, type District, WAVES } from '../../data/competition';
import { formatRupiah } from '../../lib/pricing';

export function getStaticPaths() {
  return DISTRICTS.map((district) => ({
    params: { slug: district.slug },
    props: { district }
  }));
}

interface Props {
  district: District;
}

const { district } = Astro.props;
const currentWave = WAVES.find((w) => w.isActive) || WAVES[0];
---

<BaseLayout
  title={`Pendaftaran KKA 2026 Wilayah ${district.name} - Radar Kediri`}
  description={`Informasi pendaftaran Kompetisi Kompetensi Akademik (KKA) 2026 untuk sekolah di ${district.name} (${district.regionName}).`}
>
  <section class="bg-gradient-navy text-white py-5">
    <div class="container py-3 text-center">
      <div class="mb-3 d-inline-block">
        <div class="rounded-circle bg-white p-2 shadow-sm d-inline-flex align-items-center justify-content-center" style="width: 76px; height: 76px;">
          <img 
            src={district.logoUrl || '/images/logo-kka.webp'} 
            alt={`Lambang ${district.name}`} 
            id="publicDistrictLogo"
            style="max-width: 100%; max-height: 100%; object-fit: contain;" 
          />
        </div>
      </div>
      <div>
        <span class="badge bg-primary rounded-pill px-3 py-1 mb-2">{district.regionName}</span>
      </div>
      <h1 class="display-5 fw-bold mb-2">Wilayah {district.name}</h1>
      <p class="lead text-white-50 max-w-xl mx-auto mb-1">
        Pusat seleksi dan pendaftaran pelajar berprestasi tingkat SD/MI, SMP/MTs, dan SMA/MA/SMK.
      </p>
      <Breadcrumb items={[
        { label: 'Wilayah Kompetisi', href: '/#wilayah' },
        { label: district.name, active: true }
      ]} />
    </div>
  </section>

  <section class="py-5 bg-white">
    <div class="container py-3">
      <div class="row g-5 align-items-center">
        <div class="col-lg-7">
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fs-8 fw-bold mb-2">
            ZONA KOMPETISI {district.badge.toUpperCase()}
          </span>
          <h2 class="fw-bold text-kka-primary mb-3">
            Siap Bertanding Membawa Nama Harum Sekolah di {district.name}?
          </h2>
          <p class="text-secondary mb-4" id="publicDistrictDesc">
            {district.description} Seluruh sekolah negeri dan swasta di bawah naungan Cabdindik Wilayah Jawa Timur serta Kantor Kemenag {district.name} diundang untuk berpartisipasi pada ajang tahunan KKA Jawa Pos Radar Kediri.
          </p>

          <div class="p-4 bg-light rounded-4 border mb-4">
            <h6 class="fw-bold text-dark mb-2">Tarif Gelombang Aktif Saat Ini ({currentWave.name}):</h6>
            <div class="row g-2 text-center">
              <div class="col-4">
                <div class="p-2 bg-white rounded-3 border">
                  <div class="fs-8 text-muted">SD / MI</div>
                  <div class="fw-bold text-primary">{formatRupiah(currentWave.prices.sd)}</div>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 bg-white rounded-3 border">
                  <div class="fs-8 text-muted">SMP / MTs</div>
                  <div class="fw-bold text-primary">{formatRupiah(currentWave.prices.smp)}</div>
                </div>
              </div>
              <div class="col-4">
                <div class="p-2 bg-white rounded-3 border">
                  <div class="fs-8 text-muted">SMA / MA</div>
                  <div class="fw-bold text-danger">{formatRupiah(currentWave.prices.sma)}</div>
                </div>
              </div>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-3">
            <a href={`/daftar/mandiri?wilayah=${district.id}`} class="btn btn-kka-primary px-4 py-2">
              Daftar Mandiri ({district.badge})
            </a>
            <a href={`/daftar/kolektif?wilayah=${district.id}`} class="btn btn-kka-red px-4 py-2">
              Daftar Kolektif Sekolah
            </a>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="kka-card p-4 p-xl-5 bg-white border-2">
            <h5 class="fw-bold text-kka-primary mb-3">Jadwal Seleksi {district.badge}</h5>
            <ul class="list-unstyled d-flex flex-column gap-3 small text-secondary mb-0">
              <li class="d-flex gap-2.5 align-items-start">
                <span class="p-1.5 rounded-2 bg-light border text-primary mt-0.5">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </span>
                <div>
                  <strong>Lokasi Babak Penyisihan:</strong><br />
                  <span id="publicVenueName">Laboratorium CBT Sekolah Masing-masing / Titik Uji Terpilih di {district.name}.</span>
                </div>
              </li>
              <li class="d-flex gap-2.5 align-items-start">
                <span class="p-1.5 rounded-2 bg-light border text-primary mt-0.5">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </span>
                <div>
                  <strong>Periode Pendaftaran:</strong><br />
                  2 Juni 2026 s/d 25 Juli 2026 (3 Gelombang).
                </div>
              </li>
              <li class="d-flex gap-2.5 align-items-start">
                <span class="p-1.5 rounded-2 bg-light border text-primary mt-0.5">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                </span>
                <div>
                  <strong>Kelolosan Grand Final:</strong><br />
                  Peraih peringkat tertinggi akan didelegasikan mewakili {district.name} di Kota Kediri.
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ currentSlug: district.slug, districtName: district.name }}>
    import { supabase } from '../../lib/supabase';

    (async function() {
      try {
        const { data, error } = await supabase
          .from('district_settings')
          .select('*')
          .eq('slug', currentSlug)
          .single();

        if (!error && data) {
          if (data.venue) {
            const venueEl = document.getElementById('publicVenueName');
            if (venueEl) venueEl.textContent = data.venue;
          }
          if (data.logo_url || data.image_url) {
            const logoEl = document.getElementById('publicDistrictLogo') as HTMLImageElement;
            if (logoEl) logoEl.src = data.logo_url || data.image_url;
          }
          if (data.description) {
            const descEl = document.getElementById('publicDistrictDesc');
            if (descEl) descEl.textContent = `${data.description} Seluruh sekolah negeri dan swasta di bawah naungan Cabdindik Wilayah Jawa Timur serta Kantor Kemenag ${districtName} diundang untuk berpartisipasi pada ajang tahunan KKA Jawa Pos Radar Kediri.`;
          }
        }
      } catch (e) {
        try {
          const stored = localStorage.getItem('kka_admin_district_settings');
          if (stored) {
            const settings = JSON.parse(stored);
            if (settings[currentSlug]) {
              if (settings[currentSlug].venue) {
                const venueEl = document.getElementById('publicVenueName');
                if (venueEl) venueEl.textContent = settings[currentSlug].venue;
              }
              if (settings[currentSlug].logoUrl) {
                const logoEl = document.getElementById('publicDistrictLogo') as HTMLImageElement;
                if (logoEl) logoEl.src = settings[currentSlug].logoUrl;
              }
              if (settings[currentSlug].description) {
                const descEl = document.getElementById('publicDistrictDesc');
                if (descEl) descEl.textContent = `${settings[currentSlug].description} Seluruh sekolah negeri dan swasta di bawah naungan Cabdindik Wilayah Jawa Timur serta Kantor Kemenag ${districtName} diundang untuk berpartisipasi pada ajang tahunan KKA Jawa Pos Radar Kediri.`;
              }
            }
          }
        } catch (err) {}
      }
    })();
  </script>
</BaseLayout>

<style>
  .max-w-xl { max-width: 600px; }
  .fs-8 { font-size: 0.78rem; }
</style>
