---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

// Check if query param exists
const queryKode = Astro.url.searchParams.get('kode') || '';
---

<BaseLayout 
  title="Cek Status Pendaftaran KKA 2026 - Radar Kediri"
  description="Layanan pengecekan status pendaftaran mandiri dan kolektif Kompetisi Kompetensi Akademik (KKA) 2026 Jawa Pos Radar Kediri menggunakan kode registrasi."
>
  <!-- Header Banner -->
  <section class="bg-gradient-navy text-white py-4 py-lg-5">
    <div class="container text-center py-2">
      <span class="badge bg-primary rounded-pill px-3 py-1 mb-2">LAYANAN PESERTA</span>
      <h1 class="display-6 fw-bold mb-2">Cek Status Pendaftaran KKA 2026</h1>
      <p class="lead text-white-50 max-w-2xl mx-auto mb-1">
        Periksa status verifikasi pembayaran, data rombongan peserta, dan konfirmasi panitia menggunakan kode registrasi Anda.
      </p>
      <Breadcrumb items={[
        { label: 'Pendaftaran', href: '/daftar' },
        { label: 'Cek Status', active: true }
      ]} />
    </div>
  </section>

  <!-- Search & Result Section -->
  <section class="py-5 bg-light min-vh-50">
    <div class="container py-2">
      
      <!-- Search Input Card -->
      <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm mb-4 max-w-3xl mx-auto">
        <div class="text-center mb-4">
          <div class="search-icon-badge bg-primary-subtle text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 52px; height: 52px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <h2 class="h4 fw-bold text-dark mb-1">Cari Data Pendaftaran Anda</h2>
          <p class="text-muted small mb-3" id="searchDescText">
            Masukkan Kode Registrasi yang Anda dapatkan saat mendaftar (cth: <strong>KKA26-M-NGJ-8841</strong> atau <strong>KKA26-K-NGJ-9124</strong>).
          </p>

          <!-- Toggle Mode Tabs -->
          <div class="d-inline-flex p-1 bg-light rounded-pill border mx-auto">
            <button 
              type="button" 
              id="tabSearchKode" 
              class="btn btn-sm rounded-pill fw-semibold px-3 py-1.5 btn-primary d-inline-flex align-items-center gap-1.5 shadow-2xs"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
              <span>Kode Registrasi</span>
            </button>
            <button 
              type="button" 
              id="tabSearchWa" 
              class="btn btn-sm rounded-pill fw-semibold px-3 py-1.5 text-secondary d-inline-flex align-items-center gap-1.5"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>No. WhatsApp PJ</span>
            </button>
          </div>
        </div>

        <form id="formSearchStatus" class="mb-3">
          <div class="input-group input-group-lg shadow-2xs">
            <input 
              type="text" 
              id="inputKodeReg" 
              class="form-control text-uppercase font-monospace fw-bold fs-6" 
              placeholder="Contoh: KKA26-M-NGJ-8841" 
              value={queryKode}
              required 
            />
            <button 
              type="submit" 
              id="btnCariStatus" 
              class="btn btn-primary fw-bold px-4 d-flex align-items-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <span>Cari Status</span>
            </button>
          </div>
        </form>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 text-muted small fs-8">
          <span id="searchHelperFormat">Format kode: <code>KKA26-[M/K]-[WILAYAH]-[KODE]</code></span>
          <span class="text-secondary" id="searchHelperRight">Lupa kode? Gunakan pencarian via No. WhatsApp di atas</span>
        </div>
      </div>

      <!-- Loading State Indicator -->
      <div id="loadingStatusBox" class="text-center py-5 d-none max-w-3xl mx-auto">
        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
        <h5 class="fw-bold text-dark mb-1">Memeriksa Database Supabase...</h5>
        <p class="text-secondary small mb-0">Mohon tunggu sebentar, kami sedang mengambil data pendaftaran Anda.</p>
      </div>

      <!-- Multiple Results Box (If searched by WhatsApp and multiple registrations found) -->
      <div id="multipleResultsBox" class="d-none max-w-3xl mx-auto mb-4">
        <div class="card border rounded-4 p-4 bg-white shadow-sm">
          <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom flex-wrap gap-2">
            <div>
              <h5 class="fw-bold text-dark mb-0">Ditemukan Beberapa Pendaftaran</h5>
              <p class="text-secondary small mb-0">Nomor WhatsApp ini terdaftar pada lebih dari satu pendaftaran. Silakan pilih untuk melihat rincian:</p>
            </div>
            <span class="badge bg-primary rounded-pill px-3 py-1.5" id="multipleResultsCount">0 Pendaftaran</span>
          </div>
          <div class="d-flex flex-column gap-2" id="multipleResultsList">
            <!-- Populated dynamically via JS -->
          </div>
        </div>
      </div>

      <!-- Error / Not Found Alert Box -->
      <div id="notFoundBox" class="d-none max-w-3xl mx-auto">
        <div class="alert alert-warning border-warning-subtle rounded-4 p-4 d-flex align-items-start gap-3 shadow-sm mb-4">
          <div class="text-warning mt-1 shrink-0">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
              <line x1="12" y1="9" x2="12" y2="13"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-1">Data Pendaftaran Tidak Ditemukan</h5>
            <p class="small text-secondary mb-2" id="notFoundText">
              Data yang Anda masukkan tidak terdaftar pada sistem database KKA 2026.
            </p>
            <ul class="small text-secondary ps-3 mb-0" id="notFoundTipsList">
              <li>Pastikan tidak ada salah ketik huruf atau angka.</li>
              <li>Jika mencari via WhatsApp, pastikan nomor sama dengan yang diisi saat formulir pendaftaran.</li>
              <li>Jika Anda baru saja mendaftar, pastikan formulir Anda telah berhasil disubmit.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Result Card (Found) -->
      <div id="resultStatusCard" class="d-none max-w-3xl mx-auto">
        
        <!-- Status Banner -->
        <div id="statusBannerBox" class="p-4 rounded-4 mb-4 border d-flex align-items-center gap-3 shadow-sm">
          <div id="statusIconBox" class="rounded-circle d-flex align-items-center justify-content-center shrink-0" style="width: 48px; height: 48px;">
            <!-- Injected via JS -->
          </div>
          <div>
            <div class="fs-8 text-uppercase fw-bold text-muted mb-0.5" id="statusHeaderSubtitle">Status Pendaftaran</div>
            <h4 class="h5 fw-bold mb-1" id="statusHeaderTitle">-</h4>
            <p class="small mb-0 opacity-85" id="statusHeaderDesc">-</p>
          </div>
        </div>

        <!-- Section Khusus Jika Pendaftaran Ditolak / Butuh Revisi -->
        <div id="rejectionSectionAlert" class="card border-danger border-2 rounded-4 p-4 p-md-4 bg-danger-subtle shadow-sm mb-4 d-none">
          <div class="d-flex align-items-start gap-3">
            <div class="p-2.5 rounded-circle bg-danger text-white shrink-0 mt-0.5">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
              </svg>
            </div>
            <div class="flex-grow-1">
              <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <span class="badge bg-danger text-white rounded-pill px-2.5 py-1 fs-8 fw-bold">PENDAFTARAN BUTUH REVISI</span>
                <span class="fs-8 text-danger fw-semibold">Pemberitahuan Resmi Panitia KKA</span>
              </div>
              <h5 class="fw-bold text-danger mb-2">Pendaftaran Anda Belum Dapat Diverifikasi</h5>
              <p class="text-dark small mb-3">
                Panitia KKA 2026 telah memeriksa data pendaftaran Anda, namun terdapat kendala pada verifikasi dengan rincian catatan sebagai berikut:
              </p>

              <!-- Kotak Catatan Resmi Admin -->
              <div class="p-3 bg-white rounded-3 border border-danger-subtle mb-3 shadow-2xs">
                <span class="fs-8 text-uppercase text-danger fw-bold d-block mb-1">
                  Catatan & Alasan dari Admin Panitia:
                </span>
                <div class="fs-7 text-dark fw-bold lh-base" id="rejectionNoteText">
                  -
                </div>
              </div>

              <!-- Langkah Tindak Lanjut -->
              <div class="bg-white bg-opacity-75 p-3 rounded-3 border border-danger-subtle mb-3 small">
                <strong class="text-dark d-block mb-1">Langkah Selanjutnya untuk Anda:</strong>
                <ol class="mb-0 ps-3 text-secondary">
                  <li>Jangan khawatir, pendaftaran Anda <strong>tidak otomatis hangus</strong>.</li>
                  <li>Segera hubungi tim verifikasi panitia melalui tombol WhatsApp di bawah ini.</li>
                  <li>Sampaikan <strong>Kode Registrasi (<span id="rejectionCodeMention" class="font-monospace fw-bold text-dark">-</span>)</strong> dan kirimkan bukti transfer yang valid atau perbaikan data yang diminta.</li>
                </ol>
              </div>

              <!-- Tombol Aksi Re-konfirmasi WA -->
              <div class="d-flex flex-wrap gap-2">
                <a id="btnRejectionWaHelp" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-danger fw-bold px-4 py-2.5 rounded-3 d-inline-flex align-items-center gap-2 shadow-sm">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
                  </svg>
                  <span>Kirim Perbaikan via WhatsApp Panitia</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Detail Information Box -->
        <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm mb-4">
          
          <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom flex-wrap gap-2">
            <div>
              <span class="fs-8 text-muted d-block text-uppercase fw-semibold">Kode Registrasi</span>
              <h3 class="h4 fw-black text-primary font-monospace mb-0" id="detailKode">-</h3>
            </div>
            <div class="text-md-end">
              <span class="badge rounded-pill px-3 py-1.5 fw-bold text-uppercase fs-8" id="detailTipeBadge">-</span>
              <div class="text-muted fs-8 mt-1" id="detailWaktuDaftar">-</div>
            </div>
          </div>

          <!-- 2 Columns Grid -->
          <div class="row g-3 small mb-4">
            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3 border h-100">
                <span class="text-muted d-block fs-8 mb-1">ASAL SEKOLAH</span>
                <strong class="text-dark fs-6 d-block mb-2" id="detailSekolah">-</strong>
                <span class="text-muted d-block fs-8 mb-1">WILAYAH & KECAMATAN</span>
                <span class="text-dark fw-semibold" id="detailWilayah">-</span>
              </div>
            </div>

            <div class="col-md-6">
              <div class="p-3 bg-light rounded-3 border h-100">
                <span class="text-muted d-block fs-8 mb-1">JENJANG PENDIDIKAN</span>
                <strong class="text-dark fs-6 d-block mb-2" id="detailJenjang">-</strong>
                <span class="text-muted d-block fs-8 mb-1">NO. WHATSAPP PJ / SISWA</span>
                <span class="text-dark fw-semibold" id="detailWa">-</span>
              </div>
            </div>

            <div class="col-12">
              <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                  <span class="text-muted d-block fs-8">TOTAL BIAYA PENDAFTARAN</span>
                  <strong class="text-primary fs-5 mb-0" id="detailTotalBiaya">Rp 0</strong>
                </div>
                <div id="buktiTransferActionBox">
                  <a id="btnLihatBukti" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1.5 rounded-3">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    Lihat Bukti Transfer
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Participants Table -->
          <h5 class="fw-bold text-dark mb-3 fs-6">
            Daftar Peserta Terdaftar (<span id="detailCountSiswa">0</span> Siswa)
          </h5>

          <div class="table-responsive border rounded-3 bg-white mb-4">
            <table class="table table-hover align-middle mb-0 small text-nowrap">
              <thead class="table-light">
                <tr>
                  <th style="width: 45px;" class="ps-3 text-center">#</th>
                  <th>Nama Lengkap Siswa</th>
                  <th>NISN</th>
                  <th>Gender</th>
                  <th>Kelas</th>
                </tr>
              </thead>
              <tbody id="detailTableParticipants">
                <!-- Injected via JS -->
              </tbody>
            </table>
          </div>

          <!-- Action Buttons -->
          <div class="d-flex flex-wrap gap-2 pt-2 border-top">
            <a 
              id="btnCetakBuktiResmi" 
              href="/daftar/cetak" 
              target="_blank" 
              class="btn btn-outline-dark fw-bold px-4 py-2.5 rounded-3 d-inline-flex align-items-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 6 2 18 2 18 9"/>
                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                <rect x="6" y="14" width="12" height="8"/>
              </svg>
              Cetak Lembar Bukti Resmi (PDF)
            </a>

            <a 
              id="btnWaConfirmStatus" 
              href="#" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-success fw-bold px-4 py-2.5 rounded-3 d-inline-flex align-items-center gap-2"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824z"/>
              </svg>
              Konfirmasi ke Panitia
            </a>

            <button 
              type="button" 
              id="btnResetSearch" 
              class="btn btn-outline-secondary px-3 py-2.5 rounded-3 ms-auto"
            >
              Cari Kode Lain
            </button>
          </div>

        </div>

      </div>

    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../../lib/supabase';

  document.addEventListener('DOMContentLoaded', () => {
    let searchMode: 'kode' | 'wa' = 'kode';

    const tabSearchKode = document.getElementById('tabSearchKode') as HTMLButtonElement;
    const tabSearchWa = document.getElementById('tabSearchWa') as HTMLButtonElement;
    const searchDescText = document.getElementById('searchDescText') as HTMLElement;
    const searchHelperFormat = document.getElementById('searchHelperFormat') as HTMLElement;
    const searchHelperRight = document.getElementById('searchHelperRight') as HTMLElement;

    const formSearch = document.getElementById('formSearchStatus') as HTMLFormElement;
    const inputSearch = document.getElementById('inputKodeReg') as HTMLInputElement;
    const btnCari = document.getElementById('btnCariStatus') as HTMLButtonElement;

    const loadingBox = document.getElementById('loadingStatusBox') as HTMLElement;
    const notFoundBox = document.getElementById('notFoundBox') as HTMLElement;
    const notFoundText = document.getElementById('notFoundText') as HTMLElement;
    const multipleResultsBox = document.getElementById('multipleResultsBox') as HTMLElement;
    const multipleResultsCount = document.getElementById('multipleResultsCount') as HTMLElement;
    const multipleResultsList = document.getElementById('multipleResultsList') as HTMLElement;
    const resultCard = document.getElementById('resultStatusCard') as HTMLElement;

    const statusBannerBox = document.getElementById('statusBannerBox') as HTMLElement;
    const statusIconBox = document.getElementById('statusIconBox') as HTMLElement;
    const statusHeaderTitle = document.getElementById('statusHeaderTitle') as HTMLElement;
    const statusHeaderDesc = document.getElementById('statusHeaderDesc') as HTMLElement;

    const detailKode = document.getElementById('detailKode') as HTMLElement;
    const detailTipeBadge = document.getElementById('detailTipeBadge') as HTMLElement;
    const detailWaktuDaftar = document.getElementById('detailWaktuDaftar') as HTMLElement;
    const detailSekolah = document.getElementById('detailSekolah') as HTMLElement;
    const detailWilayah = document.getElementById('detailWilayah') as HTMLElement;
    const detailJenjang = document.getElementById('detailJenjang') as HTMLElement;
    const detailWa = document.getElementById('detailWa') as HTMLElement;
    const detailTotalBiaya = document.getElementById('detailTotalBiaya') as HTMLElement;
    const btnLihatBukti = document.getElementById('btnLihatBukti') as HTMLAnchorElement;
    const buktiTransferActionBox = document.getElementById('buktiTransferActionBox') as HTMLElement;
    const detailCountSiswa = document.getElementById('detailCountSiswa') as HTMLElement;
    const detailTableParticipants = document.getElementById('detailTableParticipants') as HTMLElement;
    const btnWaConfirmStatus = document.getElementById('btnWaConfirmStatus') as HTMLAnchorElement;
    const btnCetakBuktiResmi = document.getElementById('btnCetakBuktiResmi') as HTMLAnchorElement;
    const btnResetSearch = document.getElementById('btnResetSearch') as HTMLButtonElement;

    function formatRp(val: number) {
      return 'Rp ' + Number(val).toLocaleString('id-ID');
    }

    function formatDate(isoStr: string) {
      if (!isoStr) return '-';
      const d = new Date(isoStr);
      return d.toLocaleDateString('id-ID', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      }) + ' WIB';
    }

    // Toggle Search Mode
    function setMode(mode: 'kode' | 'wa') {
      searchMode = mode;
      inputSearch.value = '';
      notFoundBox.classList.add('d-none');
      multipleResultsBox.classList.add('d-none');
      resultCard.classList.add('d-none');

      if (mode === 'kode') {
        tabSearchKode.classList.add('btn-primary', 'shadow-2xs');
        tabSearchKode.classList.remove('text-secondary');
        tabSearchWa.classList.remove('btn-primary', 'shadow-2xs');
        tabSearchWa.classList.add('text-secondary');
        inputSearch.type = 'text';
        inputSearch.className = 'form-control text-uppercase font-monospace fw-bold fs-6';
        inputSearch.placeholder = 'Contoh: KKA26-M-NGJ-8841';
        searchDescText.innerHTML = 'Masukkan Kode Registrasi yang Anda dapatkan saat mendaftar (cth: <strong>KKA26-M-NGJ-8841</strong> atau <strong>KKA26-K-NGJ-9124</strong>).';
        searchHelperFormat.innerHTML = 'Format kode: <code>KKA26-[M/K]-[WILAYAH]-[KODE]</code>';
        searchHelperRight.innerHTML = 'Lupa kode? Gunakan pencarian via No. WhatsApp di atas';
      } else {
        tabSearchWa.classList.add('btn-primary', 'shadow-2xs');
        tabSearchWa.classList.remove('text-secondary');
        tabSearchKode.classList.remove('btn-primary', 'shadow-2xs');
        tabSearchKode.classList.add('text-secondary');
        inputSearch.type = 'tel';
        inputSearch.className = 'form-control fw-bold fs-6';
        inputSearch.placeholder = 'Contoh: 081235508957 atau 0812-3550-8957';
        searchDescText.innerHTML = 'Masukkan <strong>Nomor WhatsApp Penanggung Jawab</strong> yang Anda daftarkan saat mengisi formulir.';
        searchHelperFormat.innerHTML = 'Format: Minimal 8-12 digit angka ponsel WhatsApp';
        searchHelperRight.innerHTML = 'Ingin cari via kode? Klik tab Kode Registrasi di atas';
      }
      inputSearch.focus();
    }

    tabSearchKode.addEventListener('click', () => setMode('kode'));
    tabSearchWa.addEventListener('click', () => setMode('wa'));

    // Render Full Registration Detail
    async function displayRegistration(reg: any) {
      loadingBox.classList.remove('d-none');
      try {
        const { data: participants } = await supabase
          .from('participants')
          .select('*')
          .eq('registration_id', reg.id)
          .order('created_at', { ascending: true });

        const studentList = participants || [];

        // Check for local status overrides (agar status tetap konsisten setelah aksi admin)
        try {
          const storedOverrides = localStorage.getItem('kka_status_overrides');
          if (storedOverrides) {
            const overrides = JSON.parse(storedOverrides);
            const ov = overrides[reg.kode] || (reg.id && overrides[reg.id]);
            if (ov) {
              reg.status = ov.status;
              if (ov.catatan !== undefined) reg.catatan = ov.catatan;
            }
          }
        } catch (ovErr) {
          console.warn('Error reading status overrides:', ovErr);
        }

        // Apply Status Styling
        const st = (reg.status || 'menunggu').toLowerCase();
        if (st === 'lunas') {
          statusBannerBox.className = 'p-4 rounded-4 mb-4 border d-flex align-items-center gap-3 shadow-sm bg-success-subtle border-success text-success-emphasis';
          statusIconBox.className = 'bg-success text-white rounded-circle d-flex align-items-center justify-content-center shrink-0';
          statusIconBox.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
          statusHeaderTitle.textContent = 'STATUS: PEMBAYARAN TERVERIFIKASI (LUNAS)';
          statusHeaderDesc.textContent = 'Pembayaran telah disetujui resmi oleh panitia. Data peserta valid untuk mengikuti Kompetisi Kompetensi Akademik 2026.';
        } else if (st === 'ditolak') {
          statusBannerBox.className = 'p-4 rounded-4 mb-4 border d-flex align-items-center gap-3 shadow-sm bg-danger-subtle border-danger text-danger-emphasis';
          statusIconBox.className = 'bg-danger text-white rounded-circle d-flex align-items-center justify-content-center shrink-0';
          statusIconBox.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
          statusHeaderTitle.textContent = 'STATUS: PENDAFTARAN DITOLAK / BUTUH PERBAIKAN';
          statusHeaderDesc.textContent = reg.catatan || 'Terdapat kendala pada berkas atau bukti transfer. Silakan periksa catatan admin di bawah ini.';
        } else {
          // Menunggu
          statusBannerBox.className = 'p-4 rounded-4 mb-4 border d-flex align-items-center gap-3 shadow-sm bg-warning-subtle border-warning text-dark';
          statusIconBox.className = 'bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center shrink-0';
          statusIconBox.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
          statusHeaderTitle.textContent = 'STATUS: MENUNGGU VERIFIKASI PEMBAYARAN';
          statusHeaderDesc.textContent = 'Data pendaftaran telah tersimpan. Panitia sedang mencocokkan mutasi bank rekening resmi (proses verifikasi maksimal 1x24 jam).';
        }

        // Section Khusus Catatan Penolakan Admin
        const rejBox = document.getElementById('rejectionSectionAlert');
        const rejNote = document.getElementById('rejectionNoteText');
        const rejCode = document.getElementById('rejectionCodeMention');
        const rejWaBtn = document.getElementById('btnRejectionWaHelp') as HTMLAnchorElement;

        if (rejBox && rejNote && rejCode && rejWaBtn) {
          if (st === 'ditolak') {
            rejBox.classList.remove('d-none');
            const noteContent = reg.catatan || 'Bukti transfer tidak terbaca atau nominal tidak sesuai dengan ketentuan. Silakan hubungi admin panitia melalui WhatsApp.';
            rejNote.textContent = noteContent;
            rejCode.textContent = reg.kode;

            const cleanWaText = `Halo Tim Verifikasi Panitia KKA 2026 Radar Kediri,\nSaya ingin mengonfirmasi perbaikan berkas pendaftaran saya:\n\n*Kode Registrasi*: ${reg.kode}\n*Asal Sekolah*: ${reg.sekolah || '-'}\n*Alasan / Catatan Penolakan*: "${noteContent}"\n\nBerikut saya kirimkan bukti/data perbaikan yang valid. Mohon bantuan verifikasinya kembali. Terima kasih.`;
            rejWaBtn.href = `https://wa.me/6281235508957?text=${encodeURIComponent(cleanWaText)}`;
          } else {
            rejBox.classList.add('d-none');
          }
        }

        // Populate Details
        detailKode.textContent = reg.kode;
        detailTipeBadge.textContent = (reg.tipe || 'mandiri').toUpperCase();
        detailTipeBadge.className = reg.tipe === 'kolektif' 
          ? 'badge bg-warning text-dark rounded-pill px-3 py-1.5 fw-bold fs-8' 
          : 'badge bg-primary text-white rounded-pill px-3 py-1.5 fw-bold fs-8';

        detailWaktuDaftar.textContent = `Daftar: ${formatDate(reg.created_at)}`;
        detailSekolah.textContent = reg.sekolah || '-';
        detailWilayah.textContent = `${reg.wilayah} (Kec. ${reg.kecamatan})`;
        detailJenjang.textContent = reg.jenjang || '-';
        detailWa.textContent = reg.hp_kontak || '-';
        detailTotalBiaya.textContent = formatRp(reg.total_biaya || 0);

        if (reg.bukti_bayar_url && reg.bukti_bayar_url.startsWith('http')) {
          btnLihatBukti.href = reg.bukti_bayar_url;
          buktiTransferActionBox.classList.remove('d-none');
        } else {
          buktiTransferActionBox.classList.add('d-none');
        }

        // Render Table Participants
        detailCountSiswa.textContent = String(studentList.length);
        detailTableParticipants.innerHTML = '';
        studentList.forEach((s: any, idx: number) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="ps-3 text-center text-muted fw-semibold">${idx + 1}</td>
            <td class="fw-bold text-dark">${s.nama}</td>
            <td class="font-monospace">${s.nisn || '-'}</td>
            <td>${s.gender || '-'}</td>
            <td>${s.kelas || '-'}</td>
          `;
          detailTableParticipants.appendChild(tr);
        });

        // WhatsApp Confirmation Link
        const textWa = `Halo Panitia KKA 2026 Radar Kediri,\nSaya ingin menanyakan status pendaftaran saya:\n\n*Kode Registrasi*: ${reg.kode}\n*Asal Sekolah*: ${reg.sekolah}\n*Wilayah*: ${reg.wilayah}\n*Status Saat Ini*: ${st.toUpperCase()}\n\nMohon informasi verifikasi pendaftaran saya. Terima kasih.`;
        btnWaConfirmStatus.href = `https://wa.me/6281235508957?text=${encodeURIComponent(textWa)}`;

        // Official Printable Receipt Document Link
        if (btnCetakBuktiResmi) {
          btnCetakBuktiResmi.href = `/daftar/cetak?kode=${encodeURIComponent(reg.kode)}`;
        }

        // Update URL
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('kode', reg.kode);
        window.history.replaceState({}, '', newUrl);

        // Show Result
        loadingBox.classList.add('d-none');
        resultCard.classList.remove('d-none');
        resultCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (err) {
        console.error('Error fetching detail:', err);
        loadingBox.classList.add('d-none');
      }
    }

    // Main Search Logic
    async function executeSearch(query: string) {
      const raw = query.trim();
      if (!raw) return;

      loadingBox.classList.remove('d-none');
      notFoundBox.classList.add('d-none');
      multipleResultsBox.classList.add('d-none');
      resultCard.classList.add('d-none');
      btnCari.disabled = true;

      try {
        if (searchMode === 'kode') {
          const cleanCode = raw.toUpperCase();
          const { data: reg, error } = await supabase
            .from('registrations')
            .select('*')
            .ilike('kode', cleanCode)
            .single();

          if (error || !reg) {
            notFoundText.innerHTML = `Kode registrasi <strong>"${cleanCode}"</strong> tidak ditemukan pada database kami.`;
            notFoundBox.classList.remove('d-none');
            loadingBox.classList.add('d-none');
            btnCari.disabled = false;
            return;
          }

          loadingBox.classList.add('d-none');
          displayRegistration(reg);

        } else {
          // WhatsApp search mode
          const digits = raw.replace(/[^0-9]/g, '');
          if (digits.length < 8) {
            notFoundText.textContent = 'Nomor WhatsApp terlalu pendek. Masukkan minimal 8-12 digit nomor ponsel.';
            notFoundBox.classList.remove('d-none');
            loadingBox.classList.add('d-none');
            btnCari.disabled = false;
            return;
          }

          const last8 = digits.slice(-8);
          const { data: regList, error } = await supabase
            .from('registrations')
            .select('*')
            .ilike('hp_kontak', `%${last8}%`)
            .order('created_at', { ascending: false });

          if (error || !regList || regList.length === 0) {
            notFoundText.innerHTML = `Tidak ditemukan pendaftaran yang menggunakan nomor WhatsApp <strong>"${raw}"</strong>.`;
            notFoundBox.classList.remove('d-none');
            loadingBox.classList.add('d-none');
            btnCari.disabled = false;
            return;
          }

          // Merge local overrides jika ada
          try {
            const storedOverrides = localStorage.getItem('kka_status_overrides');
            if (storedOverrides) {
              const overrides = JSON.parse(storedOverrides);
              regList.forEach(item => {
                const ov = overrides[item.kode] || (item.id && overrides[item.id]);
                if (ov) {
                  item.status = ov.status;
                  if (ov.catatan !== undefined) item.catatan = ov.catatan;
                }
              });
            }
          } catch (e) {}

          if (regList.length === 1) {
            loadingBox.classList.add('d-none');
            displayRegistration(regList[0]);
          } else {
            // Multiple records found
            multipleResultsCount.textContent = `${regList.length} Pendaftaran`;
            multipleResultsList.innerHTML = '';

            regList.forEach(item => {
              const itemDiv = document.createElement('div');
              itemDiv.className = 'p-3 rounded-3 border bg-light d-flex align-items-center justify-content-between flex-wrap gap-2 hover-card';
              
              const stBadge = (item.status || 'menunggu').toLowerCase() === 'lunas'
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Lunas</span>'
                : ((item.status || 'menunggu').toLowerCase() === 'ditolak'
                  ? '<span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Ditolak</span>'
                  : '<span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill">Menunggu</span>');

              itemDiv.innerHTML = `
                <div>
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="font-monospace fw-bold text-primary">${item.kode}</span>
                    <span class="badge bg-secondary-subtle text-dark fs-8">${(item.tipe || 'mandiri').toUpperCase()}</span>
                    ${stBadge}
                  </div>
                  <div class="small fw-semibold text-dark">${item.sekolah || '-'}</div>
                  <div class="small text-muted">${item.wilayah} - ${formatRp(item.total_biaya || 0)}</div>
                </div>
                <button type="button" class="btn btn-sm btn-primary rounded-3 fw-semibold px-3 py-1.5 btn-select-reg" data-code="${item.kode}">
                  Lihat Rincian →
                </button>
              `;

              itemDiv.querySelector('.btn-select-reg')?.addEventListener('click', () => {
                displayRegistration(item);
              });

              multipleResultsList.appendChild(itemDiv);
            });

            loadingBox.classList.add('d-none');
            multipleResultsBox.classList.remove('d-none');
            multipleResultsBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      } catch (err) {
        console.error('Search error:', err);
        notFoundText.textContent = 'Terjadi kendala saat menghubungi database. Silakan coba beberapa saat lagi.';
        notFoundBox.classList.remove('d-none');
        loadingBox.classList.add('d-none');
      } finally {
        btnCari.disabled = false;
      }
    }

    formSearch.addEventListener('submit', (e) => {
      e.preventDefault();
      executeSearch(inputSearch.value);
    });

    btnResetSearch.addEventListener('click', () => {
      inputSearch.value = '';
      resultCard.classList.add('d-none');
      multipleResultsBox.classList.add('d-none');
      notFoundBox.classList.add('d-none');
      inputSearch.focus();
    });

    // Auto search if query param provided in URL
    if (inputSearch.value.trim()) {
      executeSearch(inputSearch.value);
    }
  });
</script>

<style>
  .fs-8 { font-size: 0.78rem; }
  .max-w-2xl { max-width: 680px; }
  .max-w-3xl { max-width: 820px; }
  .min-vh-50 { min-height: 55vh; }
  
  @media print {
    /* Hide search form, headers, footer when printing */
    header, footer, #formSearchStatus, .btn, .breadcrumb-nav {
      display: none !important;
    }
    #resultStatusCard {
      display: block !important;
      max-width: 100% !important;
      box-shadow: none !important;
      border: 1px solid #000 !important;
    }
  }
