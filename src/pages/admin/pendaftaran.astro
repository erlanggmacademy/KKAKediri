        // Add backdrop if not exist
        if (!document.getElementById("modalCustomBackdrop")) {
          const back = document.createElement("div");
          back.id = "modalCustomBackdrop";
          back.className = "modal-backdrop fade show";
          document.body.appendChild(back);
        }
      }
    }

    function closeModal() {
      const modalEl = document.getElementById("verificationModal");
      if (modalEl) {
        modalEl.classList.remove("show");
        modalEl.style.display = "none";
        document.body.classList.remove("modal-open");
      }
      closeRejectModal();
      const back = document.getElementById("modalCustomBackdrop");
      if (back) back.remove();
    }

