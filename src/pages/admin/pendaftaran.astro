        rejectSekolah.textContent = currentViewingReg.sekolah || "-";
      if (rejectKontak)
        rejectKontak.textContent = `${currentViewingReg.nama_kontak || "-"} (${currentViewingReg.hp_kontak || "-"})`;
      if (txtReason) txtReason.value = currentViewingReg.catatan || "";
