          message.innerHTML = `Apakah Anda yakin ingin memverifikasi pembayaran berkas <strong>${currentViewingReg.kode}</strong> sebagai <strong>LUNAS</strong>?<br><span class="text-muted fs-9 mt-1 d-block">Setelah dikonfirmasi, WhatsApp pendaftar akan dibuka untuk mengirim konfirmasi resmi.</span>`;
