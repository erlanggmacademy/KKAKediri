---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { DISTRICTS, LEVELS } from "../../data/competition";
---

<AdminLayout
  title="Manajemen Data Pendaftaran"
  activeMenu="pendaftaran"
  pageClass="page-dashboard"
>
  <div class="page-dashboard">
    <!-- PAGE HERO BANNER -->
    <div class="dashboard-hero mb-4">
      <div class="dashboard-hero-copy">
        <span class="dashboard-eyebrow"
          >DATABASE & VERIFIKASI &bull; KKA 2026</span
        >
        <h1>Master Data Pendaftaran</h1>
        <p>
          Kelola berkas pendaftar mandiri & kolektif, verifikasi bukti transfer
          pembayaran, dan ekspor data resmi peserta try out CBT Neutron.
        </p>
      </div>

      <div class="dashboard-hero-actions">
        <button type="button" id="btnExportCsv" class="btn btn-success">
          <i class="bi bi-file-earmark-excel"></i>
          <span>Ekspor CSV / Excel</span>
        </button>
        <a href="/admin" class="btn btn-light border">
          <i class="bi bi-grid"></i>
          <span>Ringkasan Dashboard</span>
        </a>
      </div>
    </div>

    <!-- FILTER & SEARCH PANEL -->
    <div class="dashboard-panel mb-4">
      <div class="dashboard-panel-header compact py-2 px-3">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-funnel text-primary fs-6"></i>
          <span
            class="fw-bold fs-8 text-dark text-uppercase"
            style="letter-spacing: 0.05em;">Filter & Pencarian Cepat</span
          >
        </div>
        <button
          type="button"
          class="btn btn-sm btn-link text-secondary text-decoration-none fs-8 p-0"
          id="resetFilterTopBtn"
        >
          <i class="bi bi-arrow-counterclockwise"></i> Reset Filter
        </button>
      </div>

      <div class="dashboard-panel-body py-3 px-3">
        <div class="row g-3 align-items-center">
          <!-- Search Input -->
          <div class="col-12 col-lg-4">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light border-end-0 text-muted">
                <i class="bi bi-search"></i>
              </span>
              <input
                type="text"
                id="filterSearch"
                class="form-control border-start-0 fs-8 py-2"
                placeholder="Cari kode, sekolah, nama PJ, WA..."
              />
            </div>
          </div>

          <!-- Filter Status -->
          <div class="col-6 col-sm-3 col-lg-2">
            <select
              id="filterStatus"
              class="form-select form-select-sm fs-8 py-2"
            >
              <option value="all">Semua Status</option>
              <option value="menunggu">Menunggu Verifikasi</option>
              <option value="lunas">Lunas (Terverifikasi)</option>
              <option value="ditolak">Ditolak</option>
            </select>
          </div>

          <!-- Filter Wilayah -->
          <div class="col-6 col-sm-3 col-lg-2">
            <select
              id="filterWilayah"
              class="form-select form-select-sm fs-8 py-2"
            >
              <option value="all">Semua Wilayah</option>
              {DISTRICTS.map((d) => <option value={d.name}>{d.name}</option>)}
            </select>
          </div>

          <!-- Filter Jenjang -->
          <div class="col-6 col-sm-3 col-lg-2">
            <select
              id="filterJenjang"
              class="form-select form-select-sm fs-8 py-2"
            >
              <option value="all">Semua Jenjang</option>
              {LEVELS.map((l) => <option value={l.name}>{l.name}</option>)}
            </select>
          </div>

          <!-- Filter Tipe -->
          <div class="col-6 col-sm-3 col-lg-2">
            <select
              id="filterTipe"
              class="form-select form-select-sm fs-8 py-2"
            >
              <option value="all">Semua Tipe</option>
              <option value="mandiri">Mandiri</option>
              <option value="kolektif">Kolektif</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <!-- TABLE MASTER PENDAFTARAN -->
    <div class="dashboard-panel mb-4">
      <div class="dashboard-panel-header px-4 py-3">
        <div class="d-flex align-items-center gap-2">
          <span class="dashboard-section-kicker">DATABASE</span>
          <h2 class="fs-6 mb-0">Daftar Berkas Pendaftaran</h2>
          <span
            class="badge bg-primary rounded-pill px-3 py-1 fs-9 ms-1"
            id="filteredCountBadge">0 Berkas</span
          >
        </div>
        <div class="fs-8 text-secondary" id="totalSummaryText">
          Memuat data...
        </div>
      </div>

      <div class="dashboard-orders-table">
        <table class="table align-middle mb-0 fs-8">
          <thead>
            <tr>
              <th class="ps-4 text-center text-nowrap" style="width: 50px;"
                >No</th
              >
              <th class="py-3 text-nowrap">Kode Registrasi</th>
              <th class="py-3 text-nowrap">Tipe / Jenjang</th>
              <th class="py-3 text-nowrap">Sekolah / Lembaga</th>
              <th class="py-3 text-nowrap">Penanggung Jawab</th>
              <th class="py-3 text-nowrap">Wilayah</th>
              <th class="py-3 text-nowrap">Total Biaya</th>
              <th class="py-3 text-nowrap">Status Pembayaran</th>
              <th class="pe-4 text-end py-3 text-nowrap">Aksi Kelola</th>
            </tr>
          </thead>
          <tbody id="registrationsTbody">
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <div
                  class="spinner-border spinner-border-sm text-primary me-2"
                  role="status"
                >
                </div>
                <span>Mengambil database pendaftaran Supabase...</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- MODAL DETAIL & VERIFIKASI PEMBAYARAN -->
  <div
    class="modal fade"
    id="verificationModal"
    tabindex="-1"
    aria-labelledby="verificationModalLabel"
    aria-hidden="true"
  >
    <div
      class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"
    >
      <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden">
        <!-- Modal Header -->
        <div
          class="modal-header bg-white border-bottom px-4 py-3 align-items-center"
        >
          <div class="d-flex align-items-center gap-3">
            <div
              class="modal-header-icon rounded-circle d-flex align-items-center justify-content-center"
            >
              <i class="bi bi-shield-check text-primary fs-5"></i>
            </div>
            <div>
              <div class="d-flex align-items-center gap-2 flex-wrap">
                <span
                  class="badge bg-warning-subtle text-warning border border-warning-subtle fw-bold rounded-pill px-3 py-1 fs-8"
                  id="modalTipeBadge">MANDIRI</span
                >
                <h5
                  class="modal-title fw-bold font-monospace fs-6 text-dark mb-0"
                  id="modalKodeReg"
                >
                  -
                </h5>
              </div>
              <div class="fs-9 text-muted mt-1">
                Kelola Berkas Pendaftar & Status Pembayaran
              </div>
            </div>
          </div>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
            id="modalCloseBtn"></button>
        </div>

        <!-- Modal Body -->
        <div class="modal-body p-4" style="background-color: #f8fafc;">
          <!-- Status Banner inside modal -->
          <div
            class="p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-sm"
            id="modalStatusBanner"
          >
            <div class="d-flex align-items-center gap-2">
              <span class="fw-bold fs-8" id="modalStatusTitle"
                >STATUS: MENUNGGU VERIFIKASI</span
              >
            </div>
            <span class="small font-monospace fs-9" id="modalWaktuDaftar"
              >-</span
            >
          </div>

          <!-- Alert Box Catatan Penolakan (Jika status ditolak) -->
          <div
            class="alert alert-danger border-danger-subtle rounded-3 p-3 mb-3 d-none shadow-sm"
            id="modalRejectionAlertBox"
          >
            <div class="d-flex align-items-start gap-2">
              <i
                class="bi bi-exclamation-octagon-fill text-danger fs-5 flex-shrink-0 mt-1"
              ></i>
              <div class="flex-grow-1">
                <div
                  class="d-flex align-items-center justify-content-between mb-1"
                >
                  <strong class="fs-8 text-danger text-uppercase fw-bold"
                    >Alasan / Catatan Penolakan Panitia:</strong
                  >
                  <button
                    type="button"
                    class="btn btn-sm btn-outline-danger py-1 px-3 rounded-pill fs-9 fw-semibold"
                    id="btnEditRejectReason"
                  >
                    <i class="bi bi-pencil-square"></i> Ubah Catatan
                  </button>
                </div>
                <div
                  class="fs-8 text-dark fw-semibold lh-base"
                  id="modalRejectionAlertText"
                >
                  -
                </div>
              </div>
            </div>
          </div>

          <!-- 2 Columns Info Cards -->
          <div class="row g-3 mb-3">
            <!-- Info Pendaftar -->
            <div class="col-md-6">
              <div class="modal-info-card">
                <div class="modal-info-card-header">
                  <i class="bi bi-building text-primary fs-6"></i>
                  <span>Informasi Sekolah & PJ</span>
                </div>
                <div class="modal-info-item">
                  <span class="modal-info-label">Sekolah / Lembaga:</span>
                  <div class="modal-info-value" id="modalSekolah">-</div>
                </div>
                <div class="modal-info-item">
                  <span class="modal-info-label">Wilayah & Jenjang:</span>
                  <div class="modal-info-subvalue" id="modalWilayahJenjang">
                    -
                  </div>
                </div>
                <div class="modal-info-item mb-0">
                  <span class="modal-info-label">Kontak PJ / Siswa:</span>
                  <div class="modal-info-value mb-2" id="modalKontak">-</div>
                  <a
                    href="#"
                    id="modalWaDirectLink"
                    target="_blank"
                    class="btn btn-sm btn-success rounded-pill px-3 py-1 fs-8 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm"
                  >
                    <i class="bi bi-whatsapp"></i>
                    <span>Hubungi WA</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Info Pembayaran & Bukti -->
            <div class="col-md-6">
              <div class="modal-info-card">
                <div class="modal-info-card-header">
                  <i class="bi bi-receipt text-primary fs-6"></i>
                  <span>Biaya & Bukti Transfer</span>
                </div>
                <div class="modal-tagihan-box">
                  <span class="text-secondary fs-8 fw-semibold"
                    >Total Tagihan:</span
                  >
                  <span
                    class="h5 fw-bold text-primary font-monospace mb-0"
                    id="modalTotalBiaya">Rp 0</span
                  >
                </div>
                <div class="modal-info-item mb-0">
                  <span class="modal-info-label mb-2">Bukti Transfer:</span>
                  <div id="modalBuktiContainer">
                    <span class="text-muted small"
                      >Tidak ada lampiran foto bukti.</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Daftar Siswa -->
          <div class="card border rounded-3 overflow-hidden shadow-sm mt-3">
            <div
              class="bg-white px-4 py-3 border-bottom d-flex align-items-center justify-content-between"
            >
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                <span
                  class="fw-bold fs-8 text-dark text-uppercase"
                  style="letter-spacing: 0.04em;">Daftar Peserta Siswa</span
                >
              </div>
              <span
                class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fs-8 fw-bold"
                id="modalStudentCountBadge">0 Siswa</span
              >
            </div>
            <div class="table-responsive" style="max-height: 220px;">
              <table class="table align-middle mb-0 fs-8 modal-student-table">
                <thead>
                  <tr>
                    <th class="ps-3 text-center" style="width: 45px;">No</th>
                    <th>Nama Lengkap</th>
                    <th>NISN</th>
                    <th>Gender</th>
                    <th>Kelas</th>
                  </tr>
                </thead>
                <tbody id="modalStudentTbody">
                  <!-- Populated via JS -->
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Modal Footer Actions -->
        <div
          class="modal-footer bg-white border-top px-4 py-3 d-flex align-items-center justify-content-between flex-wrap gap-2"
        >
          <div class="d-flex align-items-center gap-2">
            <a
              href="#"
              id="modalPrintDocBtn"
              target="_blank"
              class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 fw-semibold fs-8"
            >
              <i class="bi bi-printer"></i>
              <span>Cetak Bukti Resmi (PDF)</span>
            </a>
          </div>

          <div class="d-flex align-items-center gap-2">
            <!-- Tombol Tolak -->
            <button
              type="button"
              class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-2 fs-8 d-inline-flex align-items-center gap-2"
              id="btnActionReject"
            >
              <i class="bi bi-x-circle"></i>
              <span>Tolak / Minta Revisi</span>
            </button>
            <!-- Tombol Verifikasi Lunas -->
            <button
              type="button"
              class="btn btn-success btn-sm rounded-pill fw-bold px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm fs-8"
              id="btnActionApprove"
            >
              <i class="bi bi-check-circle-fill"></i>
              <span>Setujui Pembayaran (LUNAS)</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL CATATAN PENOLAKAN / REVISI -->
  <div
    class="modal fade"
    id="rejectReasonModal"
    tabindex="-1"
    aria-hidden="true"
    style="z-index: 1065;"
  >
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <div
          class="modal-header bg-white border-bottom px-4 py-3 align-items-center"
        >
          <div class="d-flex align-items-center gap-2">
            <div
              class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
              style="width: 38px; height: 38px;"
            >
              <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            </div>
            <div>
              <h5 class="modal-title fs-7 fw-bold mb-0 text-dark">
                Catatan Penolakan / Revisi
              </h5>
              <div class="fs-9 text-muted mt-1">
                Berikan alasan jelas agar pendaftar dapat memperbaiki berkas
              </div>
            </div>
          </div>
          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal"
            aria-label="Close"
            id="btnCloseRejectModal"></button>
        </div>
        <div class="modal-body p-4" style="background-color: #f8fafc;">
          <div class="modal-info-card mb-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <span class="fs-9 text-muted text-uppercase fw-semibold"
                >Kode Pendaftaran:</span
              >
              <span
                class="fw-bold font-monospace text-primary fs-8"
                id="rejectModalKode">-</span
              >
            </div>
            <div class="fs-8 text-dark fw-bold" id="rejectModalSekolah">-</div>
            <div class="fs-9 text-muted" id="rejectModalKontak">-</div>
          </div>

          <!-- Quick Template Preset -->
          <div class="mb-3">
            <label class="form-label fs-9 fw-bold text-secondary text-uppercase"
              >Pilih Template Alasan Cepat</label
            >
            <select
              class="form-select form-select-sm fs-8 rounded-3"
              id="selectRejectPreset"
            >
              <option value=""
                >-- Pilih template atau ketik kustom di bawah --</option
              >
              <option
                value="Bukti transfer pembayaran buram, terpotong, atau tidak terbaca dengan jelas. Mohon kirim ulang foto struk yang jelas."
                >Bukti transfer buram / tidak terbaca</option
              >
              <option
                value="Nominal transfer tidak sesuai dengan total tagihan resmi pendaftaran. Mohon lakukan pelunasan kekurangan biaya."
                >Nominal transfer kurang / tidak sesuai</option
              >
              <option
                value="Transaksi pembayaran belum teridentifikasi pada mutasi bank panitia. Mohon pastikan nomor rekening dan tanggal transfer sesuai."
                >Transaksi belum teridentifikasi di mutasi bank</option
              >
              <option
                value="Data peserta atau NISN siswa yang diinput tidak lengkap atau terdapat duplikasi."
                >Data peserta / NISN tidak valid</option
              >
              <option
                value="Terdapat ketidaksesuaian jenjang pendidikan atau pilihan wilayah lomba."
                >Ketidaksesuaian jenjang / wilayah</option
              >
            </select>
          </div>

          <!-- Textarea Catatan -->
          <div class="mb-2">
            <label
              class="form-label fs-9 fw-bold text-secondary text-uppercase"
            >
              Catatan & Instruksi Revisi untuk Peserta <span class="text-danger"
                >*</span
              >
            </label>
            <textarea
              class="form-control fs-8 rounded-3"
              id="txtRejectReason"
              rows="4"
              placeholder="Tuliskan catatan kenapa pendaftaran ini ditolak dan apa yang harus dilakukan peserta..."
              required></textarea>
            <div class="invalid-feedback fs-9 mt-1" id="rejectReasonFeedback">
              Mohon tuliskan alasan atau catatan instruksi perbaikan untuk pendaftar.
            </div>
            <div class="form-text fs-9 text-muted mt-2">
              <i class="bi bi-info-circle me-1"></i> Catatan ini akan otomatis tampil
              di halaman <strong>Cek Status Peserta</strong> dan langsung terkirim
              ke WhatsApp pendaftar.
            </div>
          </div>
        </div>
        <div
          class="modal-footer bg-white border-top px-4 py-3 d-flex justify-content-between"
        >
          <button
            type="button"
            class="btn btn-outline-secondary btn-sm px-3 rounded-pill"
            id="btnCancelReject">Batal</button
          >
          <button
            type="button"
            class="btn btn-danger btn-sm px-4 rounded-pill fw-bold d-inline-flex align-items-center gap-2 shadow-sm"
            id="btnConfirmReject"
          >
            <i class="bi bi-x-circle"></i>
            <span>Simpan & Tolak Pendaftaran</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL KONFIRMASI AKSI (VALIDASI TAMPILAN SEBELUM EKSEKUSI STATUS & BUKA WA) -->
  <div
    class="modal fade"
    id="actionConfirmModal"
    tabindex="-1"
    aria-hidden="true"
    style="z-index: 1075; background-color: rgba(0, 0, 0, 0.55);"
  >
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden text-center">
        <div class="modal-body p-4 bg-white">
          <div
            class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
            id="confirmIconWrapper"
            style="width: 58px; height: 58px; background-color: #dff8f0;"
          >
            <i class="bi bi-question-circle-fill text-success fs-3" id="confirmIcon"></i>
          </div>
          <h5 class="fw-bold text-dark mb-1 fs-6" id="confirmTitle">
            Konfirmasi Persetujuan
          </h5>
          <div
            class="badge bg-light text-secondary border font-monospace px-3 py-1 rounded-pill mb-3 fs-8"
            id="confirmKode"
          >
            -
          </div>
          <p class="text-secondary fs-8 mb-4 lh-base" id="confirmMessage">
            Apakah Anda yakin ingin memverifikasi pembayaran pendaftaran ini?
          </p>
          <div class="d-flex align-items-center justify-content-center gap-2">
            <button
              type="button"
              class="btn btn-light border rounded-pill px-4 py-2 fs-8 fw-semibold text-secondary"
              id="btnCancelActionConfirm"
            >
              Batal
            </button>
            <button
              type="button"
              class="btn btn-success rounded-pill px-4 py-2 fs-8 fw-bold d-inline-flex align-items-center gap-2 shadow-sm"
              id="btnExecuteActionConfirm"
            >
              <i class="bi bi-check-circle"></i>
              <span id="confirmExecuteBtnText">Ya, Lanjutkan</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL FEEDBACK HASIL STATUS (POP UP TAMPILAN ELEGAN, BUKAN BROWSER ALERT) -->
  <div
    class="modal fade"
    id="statusFeedbackModal"
    tabindex="-1"
    aria-hidden="true"
    style="z-index: 1085; background-color: rgba(0, 0, 0, 0.55);"
  >
    <div class="modal-dialog modal-dialog-centered" style="max-width: 460px;">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="modal-body p-4 text-center" style="background: #ffffff;">
          <div
            class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
            id="feedbackIconWrapper"
            style="width: 60px; height: 60px; background-color: #dff8f0;"
          >
            <i
              class="bi bi-check-circle-fill text-success fs-2"
              id="feedbackIcon"></i>
          </div>
          <h4 class="fw-bold text-dark mb-1 fs-5" id="feedbackTitle">
            Status Berhasil Diperbarui!
          </h4>
          <div
            class="badge bg-light text-secondary border font-monospace px-3 py-1 rounded-pill mb-3 fs-8"
            id="feedbackKode"
          >
            -
          </div>
          <p class="text-muted fs-8 mb-4 lh-base" id="feedbackMessage">
            Pendaftaran berhasil diverifikasi. WhatsApp pendaftar otomatis
            dibuka untuk mengirimkan pesan konfirmasi.
          </p>

          <div class="d-flex flex-column gap-2">
            <a
              href="#"
              target="_blank"
              class="btn btn-success rounded-pill fw-bold py-2 fs-8 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm"
              id="btnFeedbackWa"
            >
              <i class="bi bi-whatsapp fs-6"></i>
              <span>Buka WhatsApp Pendaftar</span>
            </a>
            <button
              type="button"
              class="btn btn-light border rounded-pill py-2 fs-8 fw-semibold text-secondary"
              id="btnCloseFeedbackModal"
            >
              Tutup Dialog
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from "../../lib/supabase";

    let allRegistrations: any[] = [];
    let currentViewingReg: any = null;

    function formatRp(num: number) {
      return new Intl.NumberFormat("id-ID", {
        style: "currency",
        currency: "IDR",
        maximumFractionDigits: 0,
      }).format(num);
    }

    function formatDate(str?: string) {
      if (!str) return "-";
      try {
        const d = new Date(str);
        return d.toLocaleDateString("id-ID", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        });
      } catch (e) {
        return str;
      }
    }

    // Load Data from Supabase
    async function fetchRegistrations() {
      const tbody = document.getElementById("registrationsTbody");
      if (tbody) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="text-center py-5 text-muted">
              <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
              <span>Mengambil database pendaftaran Supabase...</span>
            </td>
          </tr>
        `;
      }

      try {
        const { data, error } = await supabase
          .from("registrations")
          .select("*")
          .order("created_at", { ascending: false });

        if (error) {
          console.warn("[Admin] Fetch error:", error.message);
        }

        allRegistrations = data || [];

        // Merge status overrides (menjaga persistensi status saat hard refresh)
        try {
          const storedOverrides = localStorage.getItem("kka_status_overrides");
          if (storedOverrides) {
            const overrides = JSON.parse(storedOverrides);
            allRegistrations.forEach((r) => {
              const ov = overrides[r.kode] || (r.id && overrides[r.id]);
              if (ov) {
                r.status = ov.status;
                if (ov.catatan !== undefined) r.catatan = ov.catatan;
              }
            });
          }
        } catch (ovErr) {
          console.warn("[Admin] Error merging overrides:", ovErr);
        }

        applyFilters();

        // Check URL Query Param for auto opening
        const urlParams = new URLSearchParams(window.location.search);
        const autoKode = urlParams.get("kode");
        const autoFilter = urlParams.get("filter");

        if (autoFilter) {
          const selectStatus = document.getElementById(
            "filterStatus",
          ) as HTMLSelectElement | null;
          if (selectStatus) {
            selectStatus.value = autoFilter;
            applyFilters();
          }
        }

        if (autoKode) {
          const target = allRegistrations.find((r) => r.kode === autoKode);
          if (target) {
            openDetailModal(target);
          }
        }
      } catch (err) {
        console.warn("[Admin] Exception:", err);
      }
    }

    // Apply Filter & Search
    function applyFilters() {
      const searchVal = (
        (document.getElementById("filterSearch") as HTMLInputElement)?.value ||
        ""
      )
        .trim()
        .toLowerCase();
      const statusVal = (
        (document.getElementById("filterStatus") as HTMLSelectElement)?.value ||
        "all"
      ).toLowerCase();
      const wilayahVal = (
        (document.getElementById("filterWilayah") as HTMLSelectElement)
          ?.value || "all"
      ).toLowerCase();
      const jenjangVal = (
        (document.getElementById("filterJenjang") as HTMLSelectElement)
          ?.value || "all"
      ).toLowerCase();
      const tipeVal = (
        (document.getElementById("filterTipe") as HTMLSelectElement)?.value ||
        "all"
      ).toLowerCase();

      const filtered = allRegistrations.filter((r) => {
        // Search text
        if (searchVal) {
          const combined =
            `${r.kode} ${r.sekolah} ${r.nama_kontak} ${r.hp_kontak} ${r.wilayah}`.toLowerCase();
          if (!combined.includes(searchVal)) return false;
        }

        // Status
        if (statusVal !== "all") {
          const st = (r.status || "menunggu").toLowerCase();
          if (st !== statusVal) return false;
        }

        // Wilayah
        if (wilayahVal !== "all") {
          const w = (r.wilayah || "").toLowerCase();
          if (!w.includes(wilayahVal) && !wilayahVal.includes(w)) return false;
        }

        // Jenjang
        if (jenjangVal !== "all") {
          const j = (r.jenjang || "").toLowerCase();
          if (!j.includes(jenjangVal) && !jenjangVal.includes(j)) return false;
        }

        // Tipe
        if (tipeVal !== "all") {
          if ((r.tipe || "mandiri").toLowerCase() !== tipeVal) return false;
        }

        return true;
      });

      renderTable(filtered);
    }

    function resetAllFilters() {
      const elSearch = document.getElementById(
        "filterSearch",
      ) as HTMLInputElement | null;
      const elStatus = document.getElementById(
        "filterStatus",
      ) as HTMLSelectElement | null;
      const elWilayah = document.getElementById(
        "filterWilayah",
      ) as HTMLSelectElement | null;
      const elJenjang = document.getElementById(
        "filterJenjang",
      ) as HTMLSelectElement | null;
      const elTipe = document.getElementById(
        "filterTipe",
      ) as HTMLSelectElement | null;

      if (elSearch) elSearch.value = "";
      if (elStatus) elStatus.value = "all";
      if (elWilayah) elWilayah.value = "all";
      if (elJenjang) elJenjang.value = "all";
      if (elTipe) elTipe.value = "all";
      applyFilters();
    }

    // Render Table Rows
    function renderTable(list: any[]) {
      const tbody = document.getElementById("registrationsTbody");
      const badgeCount = document.getElementById("filteredCountBadge");
      const summaryText = document.getElementById("totalSummaryText");

      if (badgeCount) badgeCount.textContent = `${list.length} Berkas`;
      if (summaryText)
        summaryText.textContent = `Menampilkan ${list.length} dari total ${allRegistrations.length} data pendaftaran`;

      if (!tbody) return;

      if (list.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="9" class="text-center py-5 text-muted">
              <div class="mb-2">Tidak ada data pendaftaran yang cocok dengan filter.</div>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="resetFilterBtn">
                Reset Semua Filter
              </button>
            </td>
          </tr>
        `;
        document
          .getElementById("resetFilterBtn")
          ?.addEventListener("click", resetAllFilters);
        return;
      }

      tbody.innerHTML = "";
      list.forEach((r, idx) => {
        const tr = document.createElement("tr");
        const st = (r.status || "menunggu").toLowerCase();

        let statusBadge =
          '<span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1">Menunggu</span>';
        if (st === "lunas") {
          statusBadge =
            '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Lunas</span>';
        } else if (st === "ditolak") {
          const hasNote = r.catatan
            ? `<div class="fs-9 text-danger text-truncate mt-1" style="max-width: 130px;" title="${r.catatan}"><i class="bi bi-chat-quote me-1"></i> ${r.catatan}</div>`
            : "";
          statusBadge = `<div><span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">Ditolak</span>${hasNote}</div>`;
        }

        const tipeBadge =
          r.tipe === "kolektif"
            ? '<span class="badge bg-warning text-dark px-2 py-1 rounded-pill fs-9">Kolektif</span>'
            : '<span class="badge bg-primary text-white px-2 py-1 rounded-pill fs-9">Mandiri</span>';

        let actionBtn = `
          <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 py-1 fw-bold fs-8 btn-view-reg d-inline-flex align-items-center gap-2 shadow-sm" data-kode="${r.kode}">
            <i class="bi bi-shield-check"></i>
            <span>Verifikasi</span>
          </button>
        `;
        if (st === "lunas") {
          actionBtn = `
            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold fs-8 btn-view-reg d-inline-flex align-items-center gap-2" data-kode="${r.kode}">
              <i class="bi bi-gear-fill"></i>
              <span>Kelola</span>
            </button>
          `;
        } else if (st === "ditolak") {
          actionBtn = `
            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 fw-bold fs-8 btn-view-reg d-inline-flex align-items-center gap-2" data-kode="${r.kode}">
              <i class="bi bi-sliders"></i>
              <span>Kelola</span>
            </button>
          `;
        }

        tr.innerHTML = `
          <td class="ps-4 text-center text-muted fw-semibold">${idx + 1}</td>
          <td class="text-nowrap">
            <span class="font-monospace fw-bold text-primary fs-8">${r.kode}</span>
            <div class="fs-9 text-muted">${formatDate(r.created_at)}</div>
          </td>
          <td class="text-nowrap">
            <div class="mb-1">${tipeBadge}</div>
            <div class="fs-8 text-secondary fw-semibold">${r.jenjang || "-"}</div>
          </td>
          <td>
            <div class="fw-bold text-dark text-truncate fs-8" style="max-width: 220px;">${r.sekolah || "-"}</div>
            <div class="fs-9 text-muted">Kec. ${r.kecamatan || "-"}</div>
          </td>
          <td>
            <div class="text-dark fs-8 text-truncate" style="max-width: 180px;">${r.nama_kontak || "-"}</div>
            <div class="fs-9 font-monospace text-secondary">${r.hp_kontak || "-"}</div>
          </td>
          <td class="text-nowrap">
            <span class="text-dark fw-medium fs-8">${r.wilayah || "-"}</span>
          </td>
          <td class="font-monospace fw-bold text-dark fs-8 text-nowrap">
            ${formatRp(r.total_biaya || 0)}
          </td>
          <td class="text-nowrap">
            ${statusBadge}
          </td>
          <td class="pe-4 text-end text-nowrap">
            ${actionBtn}
          </td>
        `;

        tr.querySelector(".btn-view-reg")?.addEventListener("click", () => {
          openDetailModal(r);
        });

        tbody.appendChild(tr);
      });
    }

    // Open Modal Detail
    async function openDetailModal(reg: any) {
      currentViewingReg = reg;

      const elKode = document.getElementById("modalKodeReg");
      const elTipe = document.getElementById("modalTipeBadge");
      const elStatusBanner = document.getElementById("modalStatusBanner");
      const elStatusTitle = document.getElementById("modalStatusTitle");
      const elWaktu = document.getElementById("modalWaktuDaftar");
      const elSekolah = document.getElementById("modalSekolah");
      const elWilayahJenjang = document.getElementById("modalWilayahJenjang");
      const elKontak = document.getElementById("modalKontak");
      const elWaLink = document.getElementById(
        "modalWaDirectLink",
      ) as HTMLAnchorElement | null;
      const elBiaya = document.getElementById("modalTotalBiaya");
      const elBuktiContainer = document.getElementById("modalBuktiContainer");
      const elPrintBtn = document.getElementById(
        "modalPrintDocBtn",
      ) as HTMLAnchorElement | null;
      const studentTbody = document.getElementById("modalStudentTbody");
      const studentBadge = document.getElementById("modalStudentCountBadge");
      const btnApprove = document.getElementById(
        "btnActionApprove",
      ) as HTMLButtonElement | null;
      const btnReject = document.getElementById(
        "btnActionReject",
      ) as HTMLButtonElement | null;

      if (elKode) elKode.textContent = reg.kode;
      if (elTipe) {
        elTipe.textContent = (reg.tipe || "mandiri").toUpperCase();
        elTipe.className =
          reg.tipe === "kolektif"
            ? "badge bg-warning-subtle text-warning border border-warning-subtle fw-bold rounded-pill px-3 py-1 fs-8"
            : "badge bg-primary-subtle text-primary border border-primary-subtle fw-bold rounded-pill px-3 py-1 fs-8";
      }
      if (elWaktu) {
        elWaktu.innerHTML = `<i class="bi bi-calendar3 me-1 text-muted"></i> Daftar: ${formatDate(reg.created_at)}`;
      }
      if (elSekolah) elSekolah.textContent = reg.sekolah || "-";
      if (elWilayahJenjang)
        elWilayahJenjang.textContent = `${reg.wilayah} (Kec. ${reg.kecamatan}) • ${reg.jenjang}`;
      if (elKontak)
        elKontak.textContent = `${reg.nama_kontak || "-"} (${reg.hp_kontak || "-"})`;

      // WhatsApp Direct Link
      if (elWaLink) {
        const cleanWa = (reg.hp_kontak || "").replace(/\D/g, "");
        const targetWa = cleanWa.startsWith("0")
          ? "62" + cleanWa.slice(1)
          : cleanWa;
        const msg = encodeURIComponent(
          `Halo Bpk/Ibu ${reg.nama_kontak}, kami dari Admin Verifikasi KKA 2026 Jawa Pos Radar Kediri terkait pendaftaran kode: ${reg.kode}.`,
        );
        elWaLink.href = `https://wa.me/${targetWa}?text=${msg}`;
      }

      if (elBiaya) elBiaya.textContent = formatRp(reg.total_biaya || 0);

      // Print PDF link
      if (elPrintBtn) {
        elPrintBtn.href = `/daftar/cetak?kode=${reg.kode}`;
      }

      // Status Banner
      const st = (reg.status || "menunggu").toLowerCase();
      if (elStatusBanner && elStatusTitle) {
        if (st === "lunas") {
          elStatusBanner.className =
            "p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 status-banner-lunas shadow-sm";
          elStatusTitle.innerHTML =
            '<i class="bi bi-patch-check-fill me-2 fs-6"></i> STATUS: PEMBAYARAN TERVERIFIKASI (LUNAS)';
        } else if (st === "ditolak") {
          elStatusBanner.className =
            "p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 status-banner-ditolak shadow-sm";
          elStatusTitle.innerHTML =
            '<i class="bi bi-exclamation-octagon-fill me-2 fs-6"></i> STATUS: DITOLAK / BUTUH KONFIRMASI';
        } else {
          elStatusBanner.className =
            "p-3 rounded-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2 status-banner-menunggu shadow-sm";
          elStatusTitle.innerHTML =
            '<i class="bi bi-hourglass-split me-2 fs-6"></i> STATUS: MENUNGGU VERIFIKASI PEMBAYARAN';
        }
