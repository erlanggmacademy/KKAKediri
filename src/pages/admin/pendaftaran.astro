      // Action buttons dynamic label
      if (btnApprove) {
        if (st === "lunas") {
          btnApprove.innerHTML =
            '<i class="bi bi-check2-all"></i> <span>Sudah Terverifikasi (LUNAS)</span>';
          btnApprove.className =
            "btn btn-success btn-sm rounded-pill fw-bold px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm fs-8";
        } else if (st === "ditolak") {
          btnApprove.innerHTML =
            '<i class="bi bi-check-circle-fill"></i> <span>Pulihkan & Setujui LUNAS</span>';
          btnApprove.className =
            "btn btn-success btn-sm rounded-pill fw-bold px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm fs-8";
        } else {
          btnApprove.innerHTML =
            '<i class="bi bi-check-circle-fill"></i> <span>Setujui Pembayaran (LUNAS)</span>';
          btnApprove.className =
            "btn btn-success btn-sm rounded-pill fw-bold px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm fs-8";
        }
      }

      if (btnReject) {
        if (st === "ditolak") {
          btnReject.innerHTML =
            '<i class="bi bi-pencil-square"></i> <span>Ubah Catatan Penolakan</span>';
          btnReject.className =
            "btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-2 fs-8 d-inline-flex align-items-center gap-2";
