    function closeConfirmModal() {
      const modalEl = document.getElementById("actionConfirmModal");
      if (modalEl) {
        modalEl.classList.remove("show");
        modalEl.style.display = "none";
      }
      pendingAction = null;
    }

    function openFeedbackModal(
      isSuccess: boolean,
      title: string,
      kode: string,
      msg: string,
      waUrl: string,
    ) {
      const modalEl = document.getElementById("statusFeedbackModal");
      const iconWrapper = document.getElementById("feedbackIconWrapper");
      const icon = document.getElementById("feedbackIcon");
      const elTitle = document.getElementById("feedbackTitle");
      const elKode = document.getElementById("feedbackKode");
      const elMsg = document.getElementById("feedbackMessage");
      const btnWa = document.getElementById(
        "btnFeedbackWa",
      ) as HTMLAnchorElement | null;

      if (iconWrapper && icon) {
        if (isSuccess) {
          iconWrapper.style.backgroundColor = "#dff8f0";
          icon.className = "bi bi-check-circle-fill text-success fs-2";
        } else {
          iconWrapper.style.backgroundColor = "#fde5ea";
          icon.className = "bi bi-exclamation-triangle-fill text-danger fs-2";
        }
      }

      if (elTitle) elTitle.textContent = title;
      if (elKode) elKode.textContent = kode;
      if (elMsg) elMsg.textContent = msg;
      if (btnWa) btnWa.href = waUrl;

      if (modalEl) {
        modalEl.classList.add("show");
        modalEl.style.display = "block";
        document.body.classList.add("modal-open");
      }
    }

    function closeFeedbackModal() {
      const modalEl = document.getElementById("statusFeedbackModal");
      if (modalEl) {
        modalEl.classList.remove("show");
        modalEl.style.display = "none";
        document.body.classList.remove("modal-open");
      }
      const back = document.getElementById("modalCustomBackdrop");
      if (back) back.remove();
    }

    // Update Status Action (Cepat & Langsung ke WhatsApp + Pop-up Tampilan)
    async function updateStatus(
      newStatus: "lunas" | "ditolak",
      rejectionNote: string = "",
    ) {
      if (!currentViewingReg) return;

      if (newStatus === "ditolak" && !rejectionNote) {
        openRejectModal();
        return;
      }

      const approveBtn = document.getElementById(
        "btnActionApprove",
      ) as HTMLButtonElement | null;
      const rejectBtn = document.getElementById(
        "btnActionReject",
      ) as HTMLButtonElement | null;
      const confirmRejectBtn = document.getElementById(
        "btnConfirmReject",
      ) as HTMLButtonElement | null;

      if (approveBtn) approveBtn.disabled = true;
      if (rejectBtn) rejectBtn.disabled = true;
      if (confirmRejectBtn) confirmRejectBtn.disabled = true;

      try {
        const updatePayload: any = {
          status: newStatus,
          updated_at: new Date().toISOString(),
        };
        if (newStatus === "ditolak") {
          updatePayload.catatan = rejectionNote;
        }

        // 1. Simpan ke status overrides & array lokal langsung agar UI responsif seketika
        try {
          const overrides = JSON.parse(
            localStorage.getItem("kka_status_overrides") || "{}",
          );
          const ovData = {
            status: newStatus,
            catatan: rejectionNote,
            updated_at: new Date().toISOString(),
          };
          if (currentViewingReg.kode)
            overrides[currentViewingReg.kode] = ovData;
          if (currentViewingReg.id) overrides[currentViewingReg.id] = ovData;
          localStorage.setItem(
            "kka_status_overrides",
            JSON.stringify(overrides),
          );
        } catch (ovSaveErr) {
          console.warn("[Admin] Error saving status override:", ovSaveErr);
        }

        currentViewingReg.status = newStatus;
        if (newStatus === "ditolak") {
          currentViewingReg.catatan = rejectionNote;
        }

        const found = allRegistrations.find(
          (r) =>
            r.id === currentViewingReg.id || r.kode === currentViewingReg.kode,
        );
        if (found) {
          found.status = newStatus;
          if (newStatus === "ditolak") found.catatan = rejectionNote;
        }

        // 2. Format Pesan WhatsApp Resmi Tanpa Emoji / Ikon (Profesional)
        const cleanWa = (currentViewingReg.hp_kontak || "").replace(
          /[^0-9]/g,
          "",
        );
        const targetWa = cleanWa.startsWith("0")
          ? "62" + cleanWa.slice(1)
          : cleanWa;
        const origin = window.location.origin;
        let waMsg = "";

        if (newStatus === "lunas") {
          waMsg = encodeURIComponent(
            `KONFIRMASI PEMBAYARAN RESMI KKA 2026 - RADAR KEDIRI\n\n` +
            `Yth. Bpk/Ibu ${currentViewingReg.nama_kontak || "-"},\n\n` +
            `Panitia menginformasikan bahwa pendaftaran Anda telah TERVERIFIKASI dan LUNAS:\n\n` +
            `- Kode Registrasi: ${currentViewingReg.kode}\n` +
            `- Sekolah: ${currentViewingReg.sekolah || "-"}\n` +
            `- Wilayah / Jenjang: ${currentViewingReg.wilayah || "-"} - ${currentViewingReg.jenjang || "-"}\n` +
            `- Total Biaya: ${formatRp(currentViewingReg.total_biaya || 0)}\n` +
            `- Status Pembayaran: LUNAS (TERVERIFIKASI)\n\n` +
            `Bukti konfirmasi pendaftaran resmi dapat Anda periksa melalui tautan:\n` +
            `${origin}/daftar/status?kode=${currentViewingReg.kode}\n\n` +
            `Terima kasih atas partisipasi Anda dalam Kompetisi Kompetensi Akademik (KKA) 2026 Jawa Pos Radar Kediri.\n\n` +
            `Panitia KKA 2026 Jawa Pos Radar Kediri`
          );
        } else {
          waMsg = encodeURIComponent(
            `PEMBERITAHUAN REVISI PEMBAYARAN KKA 2026 - RADAR KEDIRI\n\n` +
            `Yth. Bpk/Ibu ${currentViewingReg.nama_kontak || "-"},\n\n` +
            `Panitia menginformasikan bahwa berkas pendaftaran Anda (${currentViewingReg.kode}) memerlukan perbaikan pembayaran dengan catatan panitia:\n\n` +
            `Catatan Panitia: "${rejectionNote}"\n\n` +
            `Silakan mengirimkan bukti transfer perbaikan atau konfirmasi pembayaran secara langsung dengan membalas pesan WhatsApp ini ke nomor panitia.\n\n` +
            `Rincian status pendaftaran Anda juga dapat dilihat melalui tautan:\n` +
            `${origin}/daftar/status?kode=${currentViewingReg.kode}\n\n` +
            `Panitia KKA 2026 Jawa Pos Radar Kediri`
          );
        }

        const waUrl = `https://wa.me/${targetWa}?text=${waMsg}`;

        // 3. LANGSUNG BUKA WHATSAPP DI TAB BARU SETELAH DIVALIDASI OLEH ADMIN
        window.open(waUrl, "_blank");

        // 4. Update Tampilan & Tutup Modal Verifikasi
        applyFilters();
        closeRejectModal();
        closeModal();

        // 5. Buka Popup Tampilan Feedback Cantik
        const isLunas = newStatus === "lunas";
        const feedbackTitle = isLunas
          ? "Status Berhasil Diperbarui: LUNAS"
          : "Status Berhasil Diubah: PERLU REVISI";
        const feedbackDesc = isLunas
          ? `Status pendaftaran ${currentViewingReg.kode} telah diverifikasi lunas. Tab WhatsApp pendaftar (${currentViewingReg.hp_kontak || "peserta"}) telah dibuka untuk mengirimkan konfirmasi.`
          : `Catatan revisi tersimpan. Tab WhatsApp pendaftar (${currentViewingReg.hp_kontak || "peserta"}) telah dibuka untuk mengirimkan instruksi perbaikan berkas.`;

        openFeedbackModal(
          isLunas,
          feedbackTitle,
          currentViewingReg.kode,
          feedbackDesc,
          waUrl,
        );

        // 6. Sinkronkan ke Database Cloud Supabase & Google Spreadsheet di Latar Belakang (Non-Blocking)
        (async () => {
          try {
            const matchField = currentViewingReg.id ? "id" : "kode";
            const matchVal = currentViewingReg.id || currentViewingReg.kode;
            await supabase
              .from("registrations")
              .update(updatePayload)
              .eq(matchField, matchVal);
          } catch (dbEx) {
            console.warn("[Supabase Background Exception]:", dbEx);
          }

          const appsScriptUrl = import.meta.env.PUBLIC_APPS_SCRIPT_URL;
          if (appsScriptUrl && appsScriptUrl.startsWith("http")) {
            try {
              const statusLabel = newStatus === "lunas" ? "LUNAS" : "DITOLAK";
              await fetch(appsScriptUrl, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  action: "update_status",
                  kode: currentViewingReg.kode,
                  status: statusLabel,
                  statusBayar: statusLabel,
                  catatan: rejectionNote || "",
                }),
                mode: "no-cors",
              });
            } catch (gasErr) {
              console.warn("[Google Apps Script sync warning]:", gasErr);
            }
          }
        })();
      } catch (e: any) {
        console.error("[Update Status Error]:", e);
      } finally {
        if (approveBtn) approveBtn.disabled = false;
        if (rejectBtn) rejectBtn.disabled = false;
        if (confirmRejectBtn) confirmRejectBtn.disabled = false;
      }
    }

    // Export to CSV
    function exportToCSV() {
      if (allRegistrations.length === 0) {
        alert("Tidak ada data pendaftaran untuk diekspor.");
        return;
      }

      const headers = [
        "No",
        "Kode Registrasi",
        "Waktu Daftar",
        "Tipe",
        "Wilayah",
        "Kecamatan",
        "Sekolah",
        "Jenjang",
        "Nama Kontak PJ",
        "No WhatsApp PJ",
        "Total Biaya",
        "Status Pembayaran",
        "Catatan / Alasan",
        "URL Bukti Bayar",
      ];

      const rows = allRegistrations.map((r, idx) => [
        idx + 1,
        `"${r.kode || ""}"`,
        `"${formatDate(r.created_at)}"`,
        `"${r.tipe || "mandiri"}"`,
        `"${r.wilayah || ""}"`,
        `"${r.kecamatan || ""}"`,
        `"${(r.sekolah || "").replace(/"/g, '""')}"`,
        `"${r.jenjang || ""}"`,
        `"${(r.nama_kontak || "").replace(/"/g, '""')}"`,
        `"'\t${r.hp_kontak || ""}"`,
        r.total_biaya || 0,
        `"${r.status || "menunggu"}"`,
        `"${(r.catatan || "").replace(/"/g, '""')}"`,
        `"${r.bukti_bayar_url || ""}"`,
      ]);

      const csvContent =
        "data:text/csv;charset=utf-8,\uFEFF" +
        [headers.join(","), ...rows.map((e) => e.join(","))].join("\n");

      const encodedUri = encodeURI(csvContent);
      const link = document.createElement("a");
      link.setAttribute("href", encodedUri);
      link.setAttribute(
        "download",
        `rekap-pendaftaran-kka-radar-kediri-${Date.now()}.csv`,
      );
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Event Listeners setup
    function initPendaftaranPage() {
      fetchRegistrations();

      document
        .getElementById("filterSearch")
        ?.addEventListener("input", applyFilters);
      document
        .getElementById("filterStatus")
        ?.addEventListener("change", applyFilters);
      document
        .getElementById("filterWilayah")
        ?.addEventListener("change", applyFilters);
      document
        .getElementById("filterJenjang")
        ?.addEventListener("change", applyFilters);
      document
        .getElementById("filterTipe")
        ?.addEventListener("change", applyFilters);
      document
        .getElementById("btnExportCsv")
        ?.addEventListener("click", exportToCSV);
      document
        .getElementById("resetFilterTopBtn")
        ?.addEventListener("click", resetAllFilters);

      // Modal buttons
      document
        .getElementById("modalCloseBtn")
        ?.addEventListener("click", closeModal);
      document
        .getElementById("btnActionApprove")
        ?.addEventListener("click", () => {
          openConfirmModal("lunas");
        });
      document
        .getElementById("btnActionReject")
        ?.addEventListener("click", openRejectModal);
      document
        .getElementById("btnEditRejectReason")
        ?.addEventListener("click", openRejectModal);

      // Reject Modal buttons & inputs
      document
        .getElementById("btnCloseRejectModal")
        ?.addEventListener("click", closeRejectModal);
      document
        .getElementById("btnCancelReject")
        ?.addEventListener("click", closeRejectModal);
      document
        .getElementById("selectRejectPreset")
        ?.addEventListener("change", (e) => {
          const sel = e.target as HTMLSelectElement;
          const txt = document.getElementById(
            "txtRejectReason",
          ) as HTMLTextAreaElement;
          if (sel.value && txt) {
            txt.value = sel.value;
            txt.classList.remove("is-invalid");
          }
        });
      document
        .getElementById("txtRejectReason")
        ?.addEventListener("input", (e) => {
          (e.target as HTMLTextAreaElement)?.classList.remove("is-invalid");
        });
      document
        .getElementById("btnConfirmReject")
        ?.addEventListener("click", () => {
          const txt = document.getElementById(
            "txtRejectReason",
          ) as HTMLTextAreaElement;
          const reason = txt?.value?.trim() || "";
          if (!reason) {
            if (txt) {
              txt.classList.add("is-invalid");
              txt.focus();
            }
            return;
          }
          txt?.classList.remove("is-invalid");
          openConfirmModal("ditolak", reason);
        });

      // Action Confirm Modal buttons (Validasi Pop-up Tampilan Sebelum Buka WhatsApp)
      document
        .getElementById("btnCancelActionConfirm")
        ?.addEventListener("click", closeConfirmModal);
      document
        .getElementById("btnExecuteActionConfirm")
        ?.addEventListener("click", () => {
          if (!pendingAction) return;
          const actionToRun = pendingAction;
          closeConfirmModal();
          updateStatus(actionToRun.status, actionToRun.reason);
        });
      document
        .getElementById("actionConfirmModal")
        ?.addEventListener("click", (e) => {
          if (e.target === document.getElementById("actionConfirmModal")) {
            closeConfirmModal();
          }
        });

      // Feedback modal button & overlay click
      document
        .getElementById("btnCloseFeedbackModal")
        ?.addEventListener("click", closeFeedbackModal);
      document
        .getElementById("statusFeedbackModal")
        ?.addEventListener("click", (e) => {
          if (e.target === document.getElementById("statusFeedbackModal")) {
            closeFeedbackModal();
          }
        });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initPendaftaranPage);
    } else {
      initPendaftaranPage();
    }
    document.addEventListener("astro:page-load", initPendaftaranPage);
    window.addEventListener("admin:refresh-data", fetchRegistrations);
  </script>

