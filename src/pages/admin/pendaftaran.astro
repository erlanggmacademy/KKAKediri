          message.innerHTML = `Apakah Anda yakin ingin menetapkan berkas <strong>${currentViewingReg.kode}</strong> menjadi <strong>DITOLAK / BUTUH REVISI</strong>?<br><span class="text-muted fs-9 mt-1 d-block">Catatan perbaikan akan disimpan dan pesan WhatsApp instruksi perbaikan akan dibuka.</span>`;
