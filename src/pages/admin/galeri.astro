---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="CMS Galeri Foto Kegiatan" activeMenu="galeri">
  <div class="page-dashboard">
    <!-- PAGE HERO BANNER -->
    <div class="dashboard-hero mb-4">
      <div class="dashboard-hero-copy">
        <span class="dashboard-eyebrow">DOKUMENTASI VISUAL &bull; KKA 2026</span>
        <h1>CMS Galeri Dokumentasi</h1>
        <p>
          Kelola foto-foto dokumentasi kilas balik KKA, momen penganugerahan medali juara, suasana registrasi booth, dan kemeriahan panggung Grand Final Jawa Pos Radar Kediri.
        </p>
      </div>

      <div class="dashboard-hero-actions">
        <button type="button" class="btn btn-primary" id="btnAddGalleryItem">
          <i class="bi bi-plus-circle"></i>
          <span>Tambah Foto Baru</span>
        </button>
        <a href="/galeri" target="_blank" class="btn btn-light border">
          <i class="bi bi-box-arrow-up-right"></i>
          <span>Buka Galeri Publik</span>
        </a>
      </div>
    </div>

    <!-- FILTER KATEGORI BAR -->
    <div class="dashboard-panel mb-4">
      <div class="dashboard-panel-header compact py-3 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <span class="dashboard-section-kicker">KATEGORI FOTO</span>
          <div class="d-flex align-items-center gap-2 flex-wrap" id="galleryCategoryFilterGroup">
            <button class="btn btn-sm btn-primary active fs-9 px-3 py-1 rounded-pill" data-cat="all">Semua Foto</button>
            <button class="btn btn-sm btn-light border fs-9 px-3 py-1 rounded-pill" data-cat="grand-final">Grand Final</button>
            <button class="btn btn-sm btn-light border fs-9 px-3 py-1 rounded-pill" data-cat="juara">Juara & Penghargaan</button>
            <button class="btn btn-sm btn-light border fs-9 px-3 py-1 rounded-pill" data-cat="ujian">Pelaksanaan Ujian</button>
            <button class="btn btn-sm btn-light border fs-9 px-3 py-1 rounded-pill" data-cat="suasana">Registrasi & Suasana</button>
          </div>
        </div>
        <div class="fs-9 text-muted" id="galleryCountSummary">
          Memuat foto...
        </div>
      </div>

      <!-- GALLERY GRID BODY -->
      <div class="dashboard-panel-body">
        <div class="row g-3" id="galleryGridContainer">
          <!-- Populated via JS -->
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL CREATE & EDIT FOTO GALERI -->
  <div class="modal fade" id="galleryModal" tabindex="-1" aria-labelledby="galleryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
      <div class="modal-content border-0 rounded-4 shadow-2xl overflow-hidden">
        <div class="modal-header bg-dark text-white px-4 py-3">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-image text-warning fs-5"></i>
            <h5 class="modal-title fw-bold fs-6 text-white mb-0" id="galleryModalTitle">Tambah Foto Galeri</h5>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="galleryModalCloseBtn"></button>
        </div>

        <form id="formGallery">
          <div class="modal-body p-4">
            <input type="hidden" id="galleryId" />

            <div class="row g-3">
              <!-- Judul Foto -->
              <div class="col-12">
                <label class="form-label fw-bold fs-8 text-dark">Judul Dokumentasi Kegiatan <span class="text-danger">*</span></label>
                <input type="text" class="form-control fs-8" id="galleryTitle" placeholder="Contoh: Ratusan Finalis di Hall Utama Grand Final KKA" required />
              </div>

              <!-- Kategori -->
              <div class="col-12">
                <label class="form-label fw-bold fs-8 text-dark">Kategori Foto <span class="text-danger">*</span></label>
                <select class="form-select fs-8" id="galleryCategory" required>
                  <option value="grand-final">Grand Final (Panggung Utama)</option>
                  <option value="juara">Juara & Penghargaan (Medali & Trofi)</option>
                  <option value="ujian">Pelaksanaan Ujian (CBT & Simulasi)</option>
                  <option value="suasana">Registrasi & Suasana (Antrean & Panitia)</option>
                </select>
              </div>

              <!-- Nama File / URL Gambar -->
              <div class="col-12">
                <label class="form-label fw-bold fs-8 text-dark">Nama File / URL Foto <span class="text-danger">*</span></label>
                <div class="input-group input-group-sm">
                  <span class="input-group-text bg-light text-muted"><i class="bi bi-link-45deg"></i></span>
                  <input type="text" class="form-control fs-8 py-2" id="galleryImage" placeholder="KKA 2025 Square 29.webp atau URL gambar" required />
                </div>
                <div class="form-text fs-9 text-muted">Bisa berupa nama file di folder <code>/images/galeri/</code> atau tautan online langsung.</div>
              </div>

              <!-- Caption / Keterangan Singkat -->
              <div class="col-12">
                <label class="form-label fw-bold fs-8 text-dark">Keterangan / Caption Foto</label>
                <textarea class="form-control fs-8" id="galleryCaption" rows="3" placeholder="Uraian cerita atau suasana pada momen foto ini..."></textarea>
              </div>
            </div>
          </div>

          <div class="modal-footer bg-light px-4 py-3 d-flex align-items-center justify-content-between">
            <button type="button" class="btn btn-light btn-sm border fs-8" id="galleryModalCancelBtn">Batal</button>
            <button type="submit" class="btn btn-primary btn-sm fw-bold px-3 py-2 fs-8">
              <i class="bi bi-check-circle me-1"></i>
              <span>Simpan Foto</span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <style is:global>
    .fs-7 { font-size: 0.9rem !important; }
    .fs-8 { font-size: 0.82rem !important; }
    .fs-9 { font-size: 0.72rem !important; }
    .dashboard-panel-body {
      padding: 1.25rem 1.5rem;
    }
    .gallery-admin-card {
      border: 1px solid #eef2f6;
      border-radius: 12px;
      overflow: hidden;
      background: #ffffff;
      transition: all 0.2s ease;
    }
    .gallery-admin-card:hover {
      box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
      transform: translateY(-2px);
    }
    .gallery-admin-thumb {
      height: 180px;
      width: 100%;
      object-fit: cover;
      background-color: #f1f5f9;
    }
  </style>

  <script>
    import { supabase } from '../../lib/supabase';

    interface GalleryItem {
      id: string;
      image: string;
      title: string;
      category: string;
      filterCategory: string;
      caption: string;
    }

    const INITIAL_GALLERY: GalleryItem[] = [
      {
        id: 'gal-1',
        image: 'KKA 2025 Square 29.webp',
        title: 'Ratusan Finalis di Hall Utama Grand Final KKA',
        category: 'Grand Final',
        filterCategory: 'grand-final',
        caption: 'Foto bersama seluruh finalis terbaik, kepala sekolah, dan pimpinan Jawa Pos Radar Kediri di panggung megah Grand Final.'
      },
      {
        id: 'gal-2',
        image: 'KKA 2025 Square 24.webp',
        title: 'Penganugerahan Juara Jenjang SD/MI',
        category: 'Juara & Penghargaan',
        filterCategory: 'juara',
        caption: 'Senyum bangga para peraih juara jenjang SD/MI memegang papan kejuaraan didampingi para pejabat dinas pendidikan.'
      },
      {
        id: 'gal-3',
        image: 'KKA 2025 Square 25.webp',
        title: 'Penganugerahan Juara Jenjang SMP/MTs',
        category: 'Juara & Penghargaan',
        filterCategory: 'juara',
        caption: 'Apresiasi medali dan piagam penghargaan resmi untuk talenta terbaik jenjang SMP/MTs se-Karesidenan Kediri.'
      },
      {
        id: 'gal-4',
        image: 'KKA 2025 Square 26.webp',
        title: 'Penganugerahan Juara Jenjang SMA/MA/SMK',
        category: 'Juara & Penghargaan',
        filterCategory: 'juara',
        caption: 'Foto bersama para finalis terbaik jenjang SMA/MA se-Karesidenan Kediri di podium kehormatan.'
      },
      {
        id: 'gal-5',
        image: 'KKA 2025 Square 03.webp',
        title: 'Penyerahan Piagam Juara 1 SMA Nganjuk',
        category: 'Juara & Penghargaan',
        filterCategory: 'juara',
        caption: 'Penyerahan simbolis penghargaan Juara I jenjang SMA/SMK/MA untuk delegasi pelajar berprestasi Kabupaten Nganjuk.'
      },
      {
        id: 'gal-6',
        image: 'KKA 2025 Square 27.webp',
        title: 'Juara 1 & 3 Jenjang SMA Kota Kediri',
        category: 'Juara & Penghargaan',
        filterCategory: 'juara',
        caption: 'Momen penganugerahan Juara 1 dan 3 wilayah Kota Kediri sebagai bukti keunggulan akademik pelajar daerah.'
      },
      {
        id: 'gal-7',
        image: 'KKA 2025 Square 04.webp',
        title: 'Semarak Registration Booth Grand Final',
        category: 'Registrasi & Suasana',
        filterCategory: 'suasana',
        caption: 'Antrean tertib ratusan peserta finalis di registration booth resmi KKA bersama guru pendamping.'
      },
      {
        id: 'gal-8',
        image: 'KKA 2025 Square 05.webp',
        title: 'Verifikasi Berkas & Kartu Peserta',
        category: 'Registrasi & Suasana',
        filterCategory: 'suasana',
        caption: 'Panitia melayani pengecekan identitas dan pembagian kit ujian untuk memastikan validitas peserta.'
      },
      {
        id: 'gal-9',
        image: 'KKA 2025 Square 10.webp',
        title: 'Konsentrasi Penuh Babak Grand Final',
        category: 'Pelaksanaan Ujian',
        filterCategory: 'ujian',
        caption: 'Peserta jenjang SMA/SMK/MA fokus menuntaskan paket soal penalaran analitis berstandar TKA Nasional.'
      },
      {
        id: 'gal-10',
        image: 'KKA 2025 Square 23.webp',
        title: 'Khidmat Seremoni Indonesia Raya',
        category: 'Grand Final',
        filterCategory: 'grand-final',
        caption: 'Seluruh peserta dan dewan juri menyanyikan lagu Indonesia Raya mengawali pembukaan babak Grand Final.'
      },
      {
        id: 'gal-11',
        image: 'KKA 2025 Square 08.webp',
        title: 'Pendalaman Materi & Kisi-Kisi Soal',
        category: 'Pelaksanaan Ujian',
        filterCategory: 'ujian',
        caption: 'Peserta mempelajari modul materi dan buku panduan Neutron sebelum memasuki ruang kompetisi.'
      },
      {
        id: 'gal-12',
        image: 'KKA 2025 Square 28.webp',
        title: 'Kesiapan Mental Siswa Berprestasi',
        category: 'Pelaksanaan Ujian',
        filterCategory: 'ujian',
        caption: 'Siswa menelaah strategi pengerjaan soal dengan tenang dan percaya diri demi hasil optimal.'
      }
    ];

    let allGallery: GalleryItem[] = [];
    let activeFilter = 'all';

    async function loadGallery() {
      try {
        const stored = localStorage.getItem('kka_admin_gallery');
        if (stored) {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed) && parsed.length >= INITIAL_GALLERY.length) {
            allGallery = parsed;
          } else {
            allGallery = INITIAL_GALLERY;
            localStorage.setItem('kka_admin_gallery', JSON.stringify(INITIAL_GALLERY));
          }
          renderGalleryGrid();
        } else {
          allGallery = INITIAL_GALLERY;
          localStorage.setItem('kka_admin_gallery', JSON.stringify(INITIAL_GALLERY));
          renderGalleryGrid();
        }
      } catch (e) {
        allGallery = INITIAL_GALLERY;
      }

      try {
        const { data, error } = await supabase
          .from('gallery')
          .select('*')
          .order('created_at', { ascending: false });

        if (!error && data && data.length > 0) {
          allGallery = data.map((d: any) => ({
            id: d.id,
            image: d.image,
            title: d.title,
            category: d.category,
            filterCategory: d.filter_category || d.filterCategory,
            caption: d.caption || ''
          }));
          localStorage.setItem('kka_admin_gallery', JSON.stringify(allGallery));
          renderGalleryGrid();
        }
      } catch (err) {
        console.warn('[Supabase] Gagal mengambil foto galeri:', err);
      }
    }

    function getGallery(): GalleryItem[] {
      return allGallery.length > 0 ? allGallery : INITIAL_GALLERY;
    }

    function saveGallery(items: GalleryItem[]) {
      allGallery = items;
      localStorage.setItem('kka_admin_gallery', JSON.stringify(items));
    }

    function renderGalleryGrid() {
      const container = document.getElementById('galleryGridContainer');
      const summaryText = document.getElementById('galleryCountSummary');
      if (!container) return;

      const items = getGallery();
      const filtered = activeFilter === 'all' ? items : items.filter(g => g.filterCategory === activeFilter);

      if (summaryText) summaryText.textContent = `Menampilkan ${filtered.length} dari ${items.length} foto`;

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="col-12 text-center py-5 text-muted">
            Belum ada foto dalam kategori ini.
          </div>
        `;
        return;
      }

      container.innerHTML = '';
      filtered.forEach(item => {
        const col = document.createElement('div');
        col.className = 'col-12 col-sm-6 col-md-4';

        const imgSrc = item.image.startsWith('http') || item.image.startsWith('/') 
          ? item.image 
          : `/images/galeri/${item.image}`;

        col.innerHTML = `
          <div class="gallery-admin-card h-100 d-flex flex-column justify-content-between">
            <div>
              <div class="position-relative overflow-hidden">
                <img src="${imgSrc}" alt="${item.title}" class="gallery-admin-thumb" onerror="this.src='/images/logo-kka.webp'; this.style.objectFit='contain'; this.style.padding='20px';" />
                <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-2 px-2 py-1 fs-9 rounded">
                  ${item.category}
                </span>
              </div>
              <div class="p-3">
                <h4 class="fw-bold fs-8 text-dark mb-1 text-truncate">${item.title}</h4>
                <p class="fs-9 text-muted mb-0 line-clamp-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  ${item.caption || '-'}
                </p>
              </div>
            </div>
            <div class="px-3 pb-3 pt-0 d-flex align-items-center justify-content-between border-top pt-2">
              <span class="fs-9 text-muted font-monospace text-truncate" style="max-width: 140px;">${item.image}</span>
              <div class="d-flex align-items-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-primary px-2 py-1 fs-9 btn-edit-gal" data-id="${item.id}">
                  <i class="bi bi-pencil"></i> Edit
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger px-2 py-1 fs-9 btn-delete-gal" data-id="${item.id}">
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </div>
          </div>
        `;

        col.querySelector('.btn-edit-gal')?.addEventListener('click', () => {
          openGalleryModal(item);
        });

        col.querySelector('.btn-delete-gal')?.addEventListener('click', async () => {
          if (confirm(`Apakah Anda yakin ingin menghapus foto "${item.title}"?`)) {
            try {
              await supabase.from('gallery').delete().eq('id', item.id);
            } catch (delErr) {
              console.warn('[Supabase] Delete gallery notice:', delErr);
            }
            const updated = getGallery().filter(g => g.id !== item.id);
            saveGallery(updated);
            renderGalleryGrid();
            alert('Foto galeri berhasil dihapus dari Supabase Cloud!');
          }
        });

        container.appendChild(col);
      });
    }

    function openGalleryModal(item?: GalleryItem) {
      const modalEl = document.getElementById('galleryModal');
      const titleEl = document.getElementById('galleryModalTitle');
      const inputId = document.getElementById('galleryId') as HTMLInputElement;
      const inputTitle = document.getElementById('galleryTitle') as HTMLInputElement;
      const selectCat = document.getElementById('galleryCategory') as HTMLSelectElement;
      const inputImg = document.getElementById('galleryImage') as HTMLInputElement;
      const textareaCaption = document.getElementById('galleryCaption') as HTMLTextAreaElement;

      if (item) {
        if (titleEl) titleEl.textContent = 'Edit Foto Galeri';
        if (inputId) inputId.value = item.id;
        if (inputTitle) inputTitle.value = item.title;
        if (selectCat) selectCat.value = item.filterCategory;
        if (inputImg) inputImg.value = item.image;
        if (textareaCaption) textareaCaption.value = item.caption;
      } else {
        if (titleEl) titleEl.textContent = 'Tambah Foto Baru';
        if (inputId) inputId.value = '';
        if (inputTitle) inputTitle.value = '';
        if (selectCat) selectCat.value = 'grand-final';
        if (inputImg) inputImg.value = '';
        if (textareaCaption) textareaCaption.value = '';
      }

      if (modalEl) {
        modalEl.classList.add('show');
        modalEl.style.display = 'block';
        document.body.classList.add('modal-open');

        if (!document.getElementById('modalCustomBackdropGallery')) {
          const back = document.createElement('div');
          back.id = 'modalCustomBackdropGallery';
          back.className = 'modal-backdrop fade show';
          document.body.appendChild(back);
        }
      }
    }

    function closeGalleryModal() {
      const modalEl = document.getElementById('galleryModal');
      if (modalEl) {
        modalEl.classList.remove('show');
        modalEl.style.display = 'none';
        document.body.classList.remove('modal-open');
      }
      const back = document.getElementById('modalCustomBackdropGallery');
      if (back) back.remove();
    }

    function setupGalleryPage() {
      loadGallery();

      document.getElementById('btnAddGalleryItem')?.addEventListener('click', () => openGalleryModal());
      document.getElementById('galleryModalCloseBtn')?.addEventListener('click', closeGalleryModal);
      document.getElementById('galleryModalCancelBtn')?.addEventListener('click', closeGalleryModal);

      // Filter tabs
      const filterBtns = document.querySelectorAll('#galleryCategoryFilterGroup button');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          filterBtns.forEach(b => {
            b.classList.remove('btn-primary', 'active');
            b.classList.add('btn-light', 'border');
          });
          const target = e.currentTarget as HTMLButtonElement;
          target.classList.remove('btn-light', 'border');
          target.classList.add('btn-primary', 'active');
          activeFilter = target.getAttribute('data-cat') || 'all';
          renderGalleryGrid();
        });
      });

      document.getElementById('formGallery')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = (document.getElementById('galleryId') as HTMLInputElement).value;
        const title = (document.getElementById('galleryTitle') as HTMLInputElement).value;
        const filterCategory = (document.getElementById('galleryCategory') as HTMLSelectElement).value;
        const image = (document.getElementById('galleryImage') as HTMLInputElement).value;
        const caption = (document.getElementById('galleryCaption') as HTMLTextAreaElement).value;

        const catLabels: Record<string, string> = {
          'grand-final': 'Grand Final',
          'juara': 'Juara & Penghargaan',
          'ujian': 'Pelaksanaan Ujian',
          'suasana': 'Registrasi & Suasana'
        };

        const category = catLabels[filterCategory] || 'Dokumentasi';
        const targetId = id || ('gal-' + Date.now());

        const galleryItem: GalleryItem = {
          id: targetId,
          title,
          filterCategory,
          category,
          image,
          caption
        };

        // 1. Simpan ke Supabase Cloud
        try {
          await supabase.from('gallery').upsert({
            id: targetId,
            title,
            filter_category: filterCategory,
            category,
            image,
            caption
          });
        } catch (dbErr) {
          console.warn('[Supabase] Gagal menyimpan galeri:', dbErr);
        }

        // 2. Perbarui state lokal
        const gallery = getGallery();
        if (id) {
          const idx = gallery.findIndex(g => g.id === id);
          if (idx !== -1) gallery[idx] = galleryItem;
        } else {
          gallery.unshift(galleryItem);
        }

        saveGallery(gallery);
        renderGalleryGrid();
        closeGalleryModal();
        alert('Foto galeri berhasil disimpan ke Supabase Cloud!');
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGalleryPage);
    } else {
      setupGalleryPage();
    }
    document.addEventListener('astro:page-load', setupGalleryPage);
  </script>
</AdminLayout>
