---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout
  title="Kontak Resmi KKA Radar Kediri 2026 - Jawa Pos Radar Kediri"
  description="Layanan kontak resmi dan rekening panitia Kompetisi Kompetensi Akademik (KKA) 2026 Jawa Pos Radar Kediri."
>
  <!-- Header Section -->
  <section class="bg-gradient-navy text-white py-5">
    <div class="container py-3 text-center">
      <span class="badge bg-danger rounded-pill px-3 py-1 mb-2">Hubungi Kami</span>
      <h1 class="display-5 fw-bold mb-3">Kontak Resmi KKA Radar Kediri 2026</h1>
      <p class="lead text-white-50 max-w-2xl mx-auto mb-1">
        Kontak resmi kegiatan Kompetisi Kompetensi Akademik (KKA) Jawa Pos Radar Kediri. Silakan hubungi kami untuk informasi kerja sama, sponsor, atau kendala pendaftaran.
      </p>
      <Breadcrumb items={[{ label: 'Kontak Resmi', active: true }]} />
    </div>
  </section>

  <!-- Main Section -->
  <section class="py-5 bg-light position-relative">
    <div class="container max-w-5xl py-2">
      
      <!-- Warning Alert Banner -->
      <div class="contact-warning-card bg-white p-4 rounded-4 shadow-sm border mb-4 d-flex align-items-center gap-3">
        <div class="warning-icon-wrap shrink-0">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L1 21h22L12 2z" fill="#dc2626"/>
            <line x1="12" y1="9" x2="12" y2="13" stroke="white" stroke-width="2" stroke-linecap="round"/>
            <circle cx="12" cy="17" r="1.2" fill="white"/>
          </svg>
        </div>
        <div class="warning-text small lh-base text-dark">
          <strong class="text-danger fw-bold">MOHON DIPERHATIKAN:</strong> Segala bentuk komunikasi dan transaksi pembayaran di luar nomor kontak dan rekening yang tertera di bawah ini adalah <strong class="text-danger fw-bold">PENIPUAN</strong>. Panitia tidak bertanggung jawab atas transaksi di luar jalur resmi.
        </div>
      </div>

      <!-- 2 Columns Grid: Layanan Informasi & Metode Pembayaran -->
      <div class="row g-4">
        <!-- Kolom Kiri: Layanan Informasi -->
        <div class="col-lg-6">
          <div class="contact-panel-card bg-white rounded-4 p-4 p-md-5 shadow-sm border h-100">
            <!-- Header Panel -->
            <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0066ff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
                <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
              </svg>
              <h2 class="h5 fw-bold mb-0 text-primary" style="color: #0066ff !important;">Layanan Informasi</h2>
            </div>

            <!-- List Kontak -->
            <div class="d-flex flex-column gap-3">
              <!-- WhatsApp Admin 1 -->
              <a 
                href="https://wa.me/6281235508957?text=Halo%20Pak%20Endro%2C%20saya%20ingin%20konsultasi%20pendaftaran%20KKA%202026." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="contact-item-box"
              >
                <div class="contact-item-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16">
                    <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.016-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.807 2.05c.099.133 1.39 2.123 3.368 2.975.47.203.837.325 1.123.415.472.15.902.13 1.242.078.379-.058 1.17-.478 1.336-.94.166-.462.166-.86.116-.94-.05-.08-.182-.133-.38-.232"/>
                  </svg>
                </div>
                <div class="contact-item-info">
                  <div class="contact-item-label">WhatsApp Admin 1</div>
                  <div class="contact-item-value">0812-3550-8957 (Pak Endro)</div>
                </div>
              </a>

              <!-- WhatsApp Admin 2 -->
              <a 
                href="https://wa.me/6281359138251?text=Halo%20Mas%20Fajar%2C%20saya%20ingin%20konsultasi%20pendaftaran%20KKA%202026." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="contact-item-box"
              >
                <div class="contact-item-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16">
                    <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.016-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.807 2.05c.099.133 1.39 2.123 3.368 2.975.47.203.837.325 1.123.415.472.15.902.13 1.242.078.379-.058 1.17-.478 1.336-.94.166-.462.166-.86.116-.94-.05-.08-.182-.133-.38-.232"/>
                  </svg>
                </div>
                <div class="contact-item-info">
                  <div class="contact-item-label">WhatsApp Admin 2</div>
                  <div class="contact-item-value">0813-5913-8251 (Mas Fajar)</div>
                </div>
              </a>

              <!-- WhatsApp Admin 3 -->
              <a 
                href="https://wa.me/62815589790831?text=Halo%20Mas%20Wildan%2C%20saya%20ingin%20konsultasi%20pendaftaran%20KKA%202026." 
                target="_blank" 
                rel="noopener noreferrer" 
                class="contact-item-box"
              >
                <div class="contact-item-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 16 16">
                    <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.016-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.807 2.05c.099.133 1.39 2.123 3.368 2.975.47.203.837.325 1.123.415.472.15.902.13 1.242.078.379-.058 1.17-.478 1.336-.94.166-.462.166-.86.116-.94-.05-.08-.182-.133-.38-.232"/>
                  </svg>
                </div>
                <div class="contact-item-info">
                  <div class="contact-item-label">WhatsApp Admin 3</div>
                  <div class="contact-item-value">0815-5897-90831 (Mas Wildan)</div>
                </div>
              </a>

              <!-- Website Resmi -->
              <a href="/" class="contact-item-box">
                <div class="contact-item-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                  </svg>
                </div>
                <div class="contact-item-info">
                  <div class="contact-item-label">Website Resmi</div>
                  <div class="contact-item-value">KKA Radar Kediri 2026</div>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Metode Pembayaran -->
        <div class="col-lg-6">
          <div class="contact-panel-card bg-white rounded-4 p-4 p-md-5 shadow-sm border h-100">
            <!-- Header Panel -->
            <div class="d-flex align-items-center gap-2 mb-4 pb-3 border-bottom">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0066ff" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
              <h2 class="h5 fw-bold mb-0 text-primary" style="color: #0066ff !important;">Metode Pembayaran</h2>
            </div>

            <!-- Box Rekening Bank BRI -->
            <div class="bank-account-box p-4 rounded-4 border bg-white mt-3">
              <div class="d-flex align-items-center gap-3 gap-md-4">
                <!-- BRI Logo -->
                <div class="bri-logo-wrap shrink-0">
                  <img 
                    src="/images/bri.webp" 
                    alt="Logo Bank BRI" 
                    width="68" 
                    height="68" 
                    class="img-fluid bri-logo-img" 
                    loading="lazy"
                  />
                </div>

                <!-- Detail Rekening -->
                <div class="bank-account-info flex-grow-1">
                  <div class="bank-name fw-bold text-dark mb-1 fs-6">Bank BRI Cabang Kediri</div>
                  <div class="bank-number fw-bold mb-1 fs-5" style="color: #0066ff;">No. Rek: 0033-0100-3455-560</div>
                  <div class="bank-owner text-secondary small">A.n Heri Muda Setiawan</div>
                </div>
              </div>
            </div>

            <!-- Catatan Kaki Transfer -->
            <p class="text-muted small fst-italic mt-4 mb-0 lh-base">
              *Harap unggah bukti transfer di form pendaftaran setelah melakukan pembayaran.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA Banner Final (Desain Seragam Beranda) -->
  <section class="py-5 bg-gradient-navy text-white text-center position-relative overflow-hidden">
    <div class="container py-4 position-relative">
      <span class="badge bg-danger rounded-pill px-3 py-1 mb-3">KKA Radar Kediri 2026</span>
      <h2 class="display-6 fw-bold mb-3">Siap Mengikuti Kompetisi KKA 2026?</h2>
      <p class="lead text-white-50 max-w-xl mx-auto mb-4">
        Jika Anda memerlukan bantuan lebih lanjut atau ingin mendaftar secara kolektif rombongan sekolah, hubungi panitia melalui kontak resmi di atas.
      </p>
      <div class="d-flex flex-wrap justify-content-center gap-3">
        <a href="/daftar/mandiri" class="btn btn-kka-red btn-lg px-5 py-3 shadow-lg">
          Daftar Mandiri
        </a>
        <a href="/daftar/kolektif" class="btn btn-outline-light btn-lg px-5 py-3">
          Daftar Kolektif Sekolah
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .max-w-xl { max-width: 620px; }
  .max-w-2xl { max-width: 740px; }
  .max-w-5xl { max-width: 1040px; }

  /* Warning Alert Card */
  .contact-warning-card {
    border-left: 4.5px solid #dc2626 !important;
    border-color: rgba(0, 0, 0, 0.08) !important;
  }
  .warning-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Contact Panel Cards */
  .contact-panel-card {
    border-color: rgba(0, 0, 0, 0.08) !important;
  }

  /* Contact Item Box (Layanan Informasi) */
  .contact-item-box {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .contact-item-box:hover {
    border-color: #0066ff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 102, 255, 0.1);
  }

  .contact-item-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #0066ff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(0, 102, 255, 0.25);
    transition: transform 0.2s ease;
  }
  .contact-item-box:hover .contact-item-icon {
    transform: scale(1.08);
  }

  .contact-item-label {
    color: #1e293b;
    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .contact-item-value {
    color: #0066ff;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 1px;
  }

  /* Bank Account Box */
  .bank-account-box {
    border-color: #e2e8f0 !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .bank-account-box:hover {
    border-color: #0066ff !important;
    box-shadow: 0 6px 18px rgba(0, 102, 255, 0.08);
  }

  .bri-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bri-logo-img {
    width: 62px;
    height: 62px;
    object-fit: contain;
  }

  .bank-name {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .bank-number {
    letter-spacing: 0.2px;
  }
</style>
