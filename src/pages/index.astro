<script>
  function setupTestimoniSlider() {
    const track = document.getElementById("testimoniTrack");
    const prevBtn = document.getElementById("testimoniPrev");
    const nextBtn = document.getElementById("testimoniNext");

    if (!track || !prevBtn || !nextBtn) return;

    const getScrollAmount = () => {
      const firstItem = track.querySelector(
        ".testimoni-slide-item",
      ) as HTMLElement | null;
      if (firstItem) {
        return firstItem.clientWidth + 24; // item width + gap
      }
      return 360;
    };

    prevBtn.addEventListener("click", () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      track.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
    });
  }

  function setupFaqAccordion() {
    const list = document.getElementById("faqAccordionList");
    if (!list) return;

    const items = list.querySelectorAll(".faq-item");
    items.forEach((item) => {
      const btn = item.querySelector(".faq-trigger-btn") as HTMLButtonElement | null;
      const body = item.querySelector(".faq-collapse-body") as HTMLElement | null;
      if (!btn || !body) return;

      btn.addEventListener("click", () => {
        const isOpen = item.classList.contains("active");

        // Close all other items
        items.forEach((other) => {
          if (other !== item) {
            other.classList.remove("active");
            const otherBtn = other.querySelector(".faq-trigger-btn");
            const otherBody = other.querySelector(".faq-collapse-body");
            otherBtn?.setAttribute("aria-expanded", "false");
            otherBody?.classList.remove("open");
          }
        });

        // Toggle this item
        if (isOpen) {
          item.classList.remove("active");
          btn.setAttribute("aria-expanded", "false");
          body.classList.remove("open");
        } else {
          item.classList.add("active");
          btn.setAttribute("aria-expanded", "true");
          body.classList.add("open");
        }
      });
    });
  }

  function initPage() {
    setupTestimoniSlider();
    setupFaqAccordion();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPage);
  } else {
    initPage();
  }
  document.addEventListener("astro:page-load", initPage);
</script>
